---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProductExperience from '../components/ProductExperience.astro';
import WhySwitchCast from '../components/WhySwitchCast.astro';
import DownloadSection from '../components/DownloadSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "SwitchCast — Seamless Screen Sharing for Windows";
const pageDescription = "Share one presentation window and switch between apps, screens, images, and videos without interrupting your meetings or webinars. Download SwitchCast for Windows.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Navbar />
  <main id="main-content">
    <Hero />
    <ProductExperience />
    <WhySwitchCast />
    <DownloadSection />
  </main>
  <Footer />
</BaseLayout>
