---
import releaseData from '../data/release.json';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    
    <div class="footer-main">
      <!-- Brand & Creator -->
      <div class="footer-brand">
        <a href="/" class="brand-link">
          <img src="/assets/switchcast-logo.svg" alt="" width="22" height="22" />
          <span class="brand-title">SwitchCast</span>
        </a>
        <p class="footer-desc">
          Created by <a href="https://jeiziproductions.com" target="_blank" rel="noopener noreferrer">John Christopher King Zamora</a> under <a href="https://jeiziproductions.com" target="_blank" rel="noopener noreferrer">Jeizi Productions</a>.
        </p>
      </div>

      <!-- Essential Links -->
      <nav class="footer-nav" aria-label="Footer Links">
        <a href="/#download" class="footer-link">Download</a>
        <a href="/releases" class="footer-link">Releases</a>
        <a href={releaseData.allReleasesUrl} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub Releases</a>
        <a href={releaseData.sourceRepoUrl} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub Repository</a>
        <a href="https://jeiziproductions.com" target="_blank" rel="noopener noreferrer" class="footer-link">Jeizi Productions</a>
        <a href="mailto:johnchristopherkingzamora@gmail.com" class="footer-link">Contact</a>
      </nav>
    </div>

    <div class="footer-bottom">
      <span class="footer-copy">© {currentYear} John Christopher King Zamora. All rights reserved.</span>
    </div>

  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--sc-border-subtle);
    padding: 3.5rem 0 2.5rem 0;
    background: #09090c;
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 2rem;
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 360px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
  }

  .brand-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #ffffff;
  }

  .footer-desc {
    font-size: 0.88rem;
    color: var(--sc-text-secondary);
    line-height: 1.5;
  }

  .footer-desc a {
    color: var(--sc-text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .footer-desc a:hover {
    color: var(--sc-accent);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    align-items: center;
  }

  .footer-link {
    font-size: 0.88rem;
    color: var(--sc-text-secondary);
  }

  .footer-link:hover {
    color: #ffffff;
  }

  .footer-bottom {
    padding-top: 1.5rem;
    border-top: 1px solid var(--sc-border-subtle);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--sc-text-tertiary);
  }

  @media (max-width: 768px) {
    .footer-main {
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer-nav {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.85rem;
    }
  }
</style>
