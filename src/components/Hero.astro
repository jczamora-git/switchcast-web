---
import releaseData from '../data/release.json';
---

<section class="hero-section" id="hero">
  <div class="container hero-container">
    
    <!-- Subtle Version Tag -->
    <div class="hero-tag-wrapper reveal">
      <span class="hero-tag">
        v{releaseData.version} for Windows 10 & 11
      </span>
    </div>

    <!-- Main Headline -->
    <div class="hero-headline-group reveal">
      <h1 class="hero-title">
        SHARE ONCE.<br />
        <span class="text-accent">SWITCH SEAMLESSLY.</span>
      </h1>
      <p class="hero-description">
        Switch between apps, PowerPoint slides, cameras, screens, and media—all through one shared window.
      </p>
    </div>

    <!-- Primary & Secondary Actions -->
    <div class="hero-actions reveal">
      <a href="#download" class="btn btn-primary btn-lg hero-cta-primary">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download for Windows</span>
      </a>

      <a href="#experience" class="btn btn-secondary btn-lg hero-cta-secondary">
        <span>See How It Works</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </a>
    </div>

    <!-- Clean Platform Note -->
    <div class="hero-foot-note reveal">
      <span>Free Standalone App • No Installation Wizard • No Remote Tracking • Local-First &amp; Offline</span>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    text-align: center;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 1;
  }

  .hero-tag-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--sc-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--sc-border-base);
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-full);
  }

  .hero-headline-group {
    max-width: 860px;
    margin-bottom: 2.25rem;
  }

  .hero-title {
    font-size: clamp(2.6rem, 6.2vw, 4.4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  .text-accent {
    color: var(--sc-accent);
    background: linear-gradient(135deg, #ffffff 15%, #ff8e72 60%, #ff7a59 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: clamp(1.15rem, 2.2vw, 1.35rem);
    color: var(--sc-text-secondary);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .hero-cta-primary {
    padding: 0.85rem 2rem;
  }

  .hero-cta-secondary {
    padding: 0.85rem 1.75rem;
  }

  .hero-foot-note {
    font-size: 0.82rem;
    color: var(--sc-text-tertiary);
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .hero-cta-primary,
    .hero-cta-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>
