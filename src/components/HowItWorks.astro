---
const steps = [
  {
    stepNumber: "01",
    title: "Select Sources",
    tagline: "Queue Applications, Displays & Media",
    description: "Open the Sources tab and check off the application windows, physical displays, images (PNG, JPG), and videos (MP4, MKV) you plan to share during your presentation.",
    icon: "layers"
  },
  {
    stepNumber: "02",
    title: "Open Presentation Output",
    tagline: "Dedicated 16:9 Output Canvas",
    description: "Click 'Output Window' to launch the clean, audience-facing SwitchCast presentation window. It stays letterboxed at a standard 16:9 aspect ratio and retains a constant Win32 window handle.",
    icon: "window"
  },
  {
    stepNumber: "03",
    title: "Share the Output Window",
    tagline: "Share Once in Zoom, Teams, or Meet",
    description: "In your conferencing platform, choose 'Share Window' and select 'SwitchCast Presentation Output'. Your attendees now see whatever you project without ever seeing your private desktop.",
    icon: "share"
  },
  {
    stepNumber: "04",
    title: "Switch Without Interruptions",
    tagline: "Control via Dock, Dashboard or Hotkeys",
    description: "Use the floating companion dock or global shortcuts (Ctrl+Shift+Right/Left) to seamlessly switch between slides, code, live terminals, and video files while the audience stream never drops.",
    icon: "sparkles"
  }
];
---

<section class="section how-it-works-section" id="how-it-works">
  <div class="container">
    
    <div class="section-header reveal">
      <span class="section-tag">Presentation Workflow</span>
      <h2 class="section-title">How SwitchCast Transforms Your Screen Shares</h2>
      <p class="section-subtitle">
        Four simple steps to eliminate screen-sharing anxiety, prevent private data leaks, and present like a seasoned broadcast professional.
      </p>
    </div>

    <!-- Workflow Step Cards -->
    <div class="steps-grid">
      {steps.map((step, idx) => (
        <div class="step-card glass-card hover-lift reveal" style={`transition-delay: ${idx * 100}ms;`}>
          <div class="step-card-header">
            <span class="step-num">{step.stepNumber}</span>
            <span class="step-indicator">STEP</span>
          </div>

          <h3 class="step-title">{step.title}</h3>
          <span class="step-tagline">{step.tagline}</span>
          <p class="step-desc">{step.description}</p>

          <div class="step-footer">
            <span class="step-line"></span>
          </div>
        </div>
      ))}
    </div>

    <!-- Workflow Highlight Box -->
    <div class="workflow-callout glass-card reveal">
      <div class="callout-content">
        <div class="callout-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </div>
        <div class="callout-text">
          <span class="callout-title">Zero Accidental Desktop Exposure</span>
          <p>Conferencing attendees only see what is deliberately routed to the Presentation Output window. Your desktop wallpapers, taskbars, private chats, emails, and notifications stay completely invisible.</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3.5rem;
    position: relative;
  }

  .step-card {
    padding: 2.25rem 1.75rem;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .step-card-header {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin-bottom: 1.25rem;
  }

  .step-num {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1;
    color: var(--sc-accent);
  }

  .step-indicator {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sc-text-tertiary);
    letter-spacing: 0.1em;
  }

  .step-title {
    font-size: 1.3rem;
    margin-bottom: 0.35rem;
    color: #ffffff;
  }

  .step-tagline {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sc-accent);
    margin-bottom: 0.85rem;
    display: block;
  }

  .step-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sc-text-secondary);
    flex: 1;
  }

  .step-footer {
    margin-top: 1.5rem;
  }

  .step-line {
    display: block;
    height: 2px;
    background: linear-gradient(90deg, var(--sc-accent) 0%, transparent 100%);
    width: 60px;
  }

  /* Callout */
  .workflow-callout {
    padding: 1.75rem 2rem;
    border: 1px solid var(--sc-border-base);
    background: rgba(255, 122, 89, 0.04);
  }

  .callout-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .callout-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: var(--sc-accent-soft);
    border: 1px solid rgba(255, 122, 89, 0.25);
    border-radius: var(--radius-md);
    color: var(--sc-accent);
    flex-shrink: 0;
  }

  .callout-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
    display: block;
    margin-bottom: 0.25rem;
  }

  .callout-text p {
    font-size: 0.92rem;
    color: var(--sc-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .steps-grid {
      grid-template-columns: 1fr;
    }

    .callout-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }
</style>
