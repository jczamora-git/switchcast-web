---
// SwitchCast Product Storyboard — Continuous Tutorial Experience
// Authentic application workflows based on SwitchCast v1.5.0

interface StoryboardChapter {
  index: string;
  tag: string;
  title: string;
  description: string;
  steps: {
    number: string;
    text: string;
  }[];
  screenshot: string;
  alt: string;
  aspectRatio: string;
  tip?: {
    label: string;
    text: string;
  };
}

const chapters: StoryboardChapter[] = [
  {
    index: '01',
    tag: 'PREPARE',
    title: 'Prepare your presentation.',
    description: 'Select running applications, PowerPoint decks, and media files to build your presentation lineup before going live.',
    steps: [
      { number: '01', text: 'Open the Sources tab.' },
      { number: '02', text: 'Choose the applications, displays, PowerPoint files, or media you need.' },
      { number: '03', text: 'Add them to your presentation queue.' }
    ],
    screenshot: '/screenshots/sources.webp',
    alt: 'SwitchCast Sources Manager interface showing application catalog and queue checkboxes',
    aspectRatio: '16/9'
  },
  {
    index: '02',
    tag: 'SHARE',
    title: 'One window for your entire presentation.',
    description: 'Launch the dedicated Presentation Output window once and share it with your audience. Everything routes through this single window.',
    steps: [
      { number: '01', text: 'Open the Presentation Output.' },
      { number: '02', text: 'Start your presentation with a queued source.' },
      { number: '03', text: 'Share the SwitchCast output window in your meeting application.' }
    ],
    screenshot: '/screenshots/presentation-output.webp',
    alt: 'SwitchCast Presentation Output canvas displaying presentation slides',
    aspectRatio: '16/9',
    tip: {
      label: 'Audio Sharing Tip',
      text: 'When presenting video or media clips, remember to check "Share system audio" or "Include computer sound" in your meeting conferencing app.'
    }
  },
  {
    index: '03',
    tag: 'SWITCH',
    title: 'Move between sources without interrupting your audience.',
    description: 'Transition smoothly between apps, slides, and media files without stopping screen share or exposing background windows.',
    steps: [
      { number: '01', text: 'Select your next queued source.' },
      { number: '02', text: 'Use the Dashboard or Presenter Dock to switch.' },
      { number: '03', text: 'Keep the same Presentation Output shared.' }
    ],
    screenshot: '/screenshots/dashboard.webp',
    alt: 'SwitchCast Dashboard displaying live presentation session and source switching controls',
    aspectRatio: '16/9',
    tip: {
      label: 'Switching Modes',
      text: 'SwitchCast supports instant switching or preview-first modes so you can stage content before presenting to your audience.'
    }
  },
  {
    index: '04',
    tag: 'CONTROL',
    title: 'Everything within reach.',
    description: 'The compact Presenter Dock floats over your full-screen apps so navigation, pause, and privacy blackout are always accessible.',
    steps: [
      { number: '01', text: 'Open the floating Presenter Dock.' },
      { number: '02', text: 'Navigate between sources or select a switching mode.' },
      { number: '03', text: 'Pause or blackout your presentation when needed.' }
    ],
    screenshot: '/screenshots/presenter-dock.webp',
    alt: 'SwitchCast Floating Presenter Dock with source switching, pause, and privacy blackout controls',
    aspectRatio: '21/2',
    tip: {
      label: 'Keyboard Shortcuts',
      text: 'Ctrl+Shift+Right/Left cycles through sources. Ctrl+Shift+P pauses output. Ctrl+Shift+B toggles privacy blackout.'
    }
  },
  {
    index: '05',
    tag: 'PRESENT',
    title: 'Bring your slides and media together.',
    description: 'Present PowerPoint slide decks, high-resolution imagery, and video clips directly through the built-in presentation engine.',
    steps: [
      { number: '01', text: 'Import a supported presentation or media file.' },
      { number: '02', text: 'Add it to the presentation queue.' },
      { number: '03', text: 'Use the available presentation or media controls.' }
    ],
    screenshot: '/screenshots/powerpoint.webp',
    alt: 'SwitchCast presenting slide deck with native presentation controls',
    aspectRatio: '16/9'
  },
  {
    index: '06',
    tag: 'PLAY',
    title: 'Set the mood with background music.',
    description: 'Curate walk-in playlists and presentation music that runs independently from your visual screen-sharing channels.',
    steps: [
      { number: '01', text: 'Open Music & Playlists.' },
      { number: '02', text: 'Prepare your audio lineup.' },
      { number: '03', text: 'Control background music independently.' }
    ],
    screenshot: '/screenshots/music-playlists.webp',
    alt: 'SwitchCast Playlists tab managing background audio and playlist volume',
    aspectRatio: '16/9'
  }
];
---

<section id="tutorials" class="storyboard-section" aria-labelledby="storyboard-heading">
  <div class="site-container">
    <!-- Section Header aligned to editorial grid -->
    <div class="storyboard-header">
      <div class="storyboard-header-left">
        <span class="editorial-tag">GETTING STARTED</span>
        <h2 id="storyboard-heading" class="storyboard-title">A Visual Product Storyboard</h2>
      </div>
      <p class="storyboard-subtitle">
        Follow the six sequential phases of a seamless SwitchCast presentation. From preparing sources to live switching and background audio.
      </p>
    </div>

    <!-- Continuous Storyboard Editorial Shell -->
    <div class="editorial-shell storyboard-shell">
      {chapters.map((chapter, idx) => {
        const isReversed = idx % 2 === 1;
        return (
          <article 
            id={`chapter-${chapter.index}`}
            class={`storyboard-row ${isReversed ? 'row-reversed' : ''}`}
          >
            <!-- Copy Cell -->
            <div class="storyboard-cell storyboard-copy">
              <div class="chapter-meta">
                <span class="chapter-num">{chapter.index}</span>
                <span class="chapter-divider">/</span>
                <span class="chapter-tag">{chapter.tag}</span>
              </div>

              <h3 class="chapter-title">{chapter.title}</h3>
              <p class="chapter-desc">{chapter.description}</p>

              <!-- Streamlined Vertical Step List -->
              <ol class="storyboard-steps">
                {chapter.steps.map((step) => (
                  <li class="storyboard-step">
                    <span class="step-num">{step.number}</span>
                    <span class="step-text">{step.text}</span>
                  </li>
                ))}
              </ol>

              {chapter.tip && (
                <div class="chapter-tip">
                  <span class="tip-label">{chapter.tip.label}:</span>
                  <span class="tip-text">{chapter.tip.text}</span>
                </div>
              )}
            </div>

            <!-- Visual Cell with 1px divider -->
            <div class="storyboard-cell storyboard-visual">
              <div class={`visual-viewport ${chapter.aspectRatio === '21/2' ? 'dock-viewport' : ''}`}>
                <img
                  src={chapter.screenshot}
                  alt={chapter.alt}
                  class="storyboard-img"
                  loading="lazy"
                  decoding="async"
                />
                <button
                  type="button"
                  class="storyboard-zoom-btn"
                  data-zoom-src={chapter.screenshot}
                  data-zoom-caption={`${chapter.index} · ${chapter.title}`}
                  aria-label={`Enlarge screenshot: ${chapter.title}`}
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
                  </svg>
                  <span>Enlarge</span>
                </button>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<!-- Lightbox Modal for authentic screenshot inspection -->
<div id="storyboardLightbox" class="storyboard-lightbox" style="display: none;" role="dialog" aria-modal="true" aria-label="Screenshot enlargement">
  <div class="lightbox-overlay" id="lightboxBackdrop"></div>
  <div class="lightbox-dialog">
    <div class="lightbox-bar">
      <span id="lightboxCaption" class="lightbox-title">SwitchCast Application View</span>
      <button type="button" id="lightboxCloseBtn" class="lightbox-close" aria-label="Close dialog">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="lightbox-body">
      <img id="lightboxImg" src="" alt="Enlarged SwitchCast screenshot" />
    </div>
  </div>
</div>

<style>
  .storyboard-section {
    padding: 6rem 0;
    position: relative;
    background: var(--sc-bg-primary);
  }

  .storyboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.5rem;
    gap: 2rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--sc-border-base);
    padding-bottom: 1.75rem;
  }

  .storyboard-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--sc-text-primary);
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0 0;
  }

  .storyboard-subtitle {
    max-width: 520px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--sc-text-secondary);
    margin: 0;
  }

  /* Storyboard Continuous Shell */
  .storyboard-shell {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-sm);
    background: var(--sc-bg-surface);
    overflow: hidden;
  }

  .storyboard-row {
    display: grid;
    grid-template-columns: 5fr 7fr;
    border-bottom: 1px solid var(--sc-border-base);
    min-height: 420px;
  }

  .storyboard-row:last-child {
    border-bottom: none;
  }

  /* Asymmetric Alternate Reading Order on Desktop */
  .storyboard-row.row-reversed {
    grid-template-columns: 7fr 5fr;
  }

  .storyboard-row.row-reversed .storyboard-copy {
    order: 2;
    border-left: 1px solid var(--sc-border-base);
    border-right: none;
  }

  .storyboard-row.row-reversed .storyboard-visual {
    order: 1;
  }

  /* Copy Cell */
  .storyboard-copy {
    padding: 3rem 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-right: 1px solid var(--sc-border-base);
    background: rgba(18, 18, 22, 0.4);
  }

  .chapter-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sc-accent-coral);
    margin-bottom: 0.75rem;
  }

  .chapter-divider {
    color: var(--sc-text-muted);
  }

  .chapter-title {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--sc-text-primary);
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0 0 0.75rem 0;
  }

  .chapter-desc {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--sc-text-secondary);
    margin: 0 0 1.75rem 0;
  }

  /* Vertical Numbered Steps (No individual cards) */
  .storyboard-steps {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .storyboard-step {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.88rem;
    color: var(--sc-text-primary);
    line-height: 1.45;
  }

  .step-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sc-accent-coral);
    flex-shrink: 0;
  }

  .step-text {
    color: #e4e4e7;
  }

  /* Subtle contextual tip */
  .chapter-tip {
    font-size: 0.8rem;
    line-height: 1.45;
    padding: 0.65rem 0.85rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: var(--radius-sm);
    color: var(--sc-text-muted);
  }

  .tip-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--sc-text-secondary);
    margin-right: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Visual Cell */
  .storyboard-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #09090c;
    padding: 2rem;
    position: relative;
    overflow: hidden;
  }

  .visual-viewport {
    position: relative;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(14, 14, 18, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    overflow: hidden;
  }

  .dock-viewport {
    padding: 2rem 1.5rem;
    background: rgba(10, 10, 14, 0.95);
  }

  .storyboard-img {
    width: 100%;
    height: auto;
    max-height: 380px;
    object-fit: contain;
    display: block;
    transition: transform 0.25s ease;
  }

  .dock-viewport .storyboard-img {
    max-height: 90px;
    object-fit: contain;
  }

  /* Enlarge button */
  .storyboard-zoom-btn {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.35rem 0.65rem;
    background: rgba(15, 15, 20, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    color: var(--sc-text-primary);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .storyboard-zoom-btn:hover {
    background: rgba(255, 87, 34, 0.15);
    border-color: var(--sc-accent-coral);
    color: #ffffff;
  }

  /* Lightbox Modal */
  .storyboard-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 8, 0.88);
    backdrop-filter: blur(12px);
  }

  .lightbox-dialog {
    position: relative;
    z-index: 1001;
    max-width: 1100px;
    width: 100%;
    background: #0d0d12;
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-sm);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.8);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .lightbox-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--sc-border-base);
    background: #121217;
  }

  .lightbox-title {
    font-size: 0.85rem;
    font-family: var(--font-mono);
    color: var(--sc-text-primary);
  }

  .lightbox-close {
    background: transparent;
    border: none;
    color: var(--sc-text-secondary);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.25rem;
    border-radius: 4px;
    transition: color 0.15s ease;
  }

  .lightbox-close:hover {
    color: #ffffff;
  }

  .lightbox-body {
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #07070a;
  }

  .lightbox-body img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 2px;
  }

  /* Responsive Rules */
  @media (max-width: 960px) {
    .storyboard-row,
    .storyboard-row.row-reversed {
      grid-template-columns: 1fr;
    }

    .storyboard-row.row-reversed .storyboard-copy {
      order: 1;
      border-left: none;
      border-right: none;
    }

    .storyboard-row.row-reversed .storyboard-visual {
      order: 2;
    }

    .storyboard-copy {
      padding: 2.25rem 1.75rem;
      border-right: none;
      border-bottom: 1px solid var(--sc-border-base);
    }

    .storyboard-visual {
      padding: 1.5rem;
    }

    .storyboard-title {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 640px) {
    .storyboard-section {
      padding: 4rem 0;
    }

    .storyboard-copy {
      padding: 1.75rem 1.25rem;
    }

    .chapter-title {
      font-size: 1.25rem;
    }

    .storyboard-visual {
      padding: 1rem;
    }

    .dock-viewport {
      padding: 1.25rem 0.75rem;
    }
  }
</style>

<script>
  // Lightbox Modal Interactivity
  const lightbox = document.getElementById('storyboardLightbox');
  const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightboxCaption');
  const lightboxCloseBtn = document.getElementById('lightboxCloseBtn');
  const lightboxBackdrop = document.getElementById('lightboxBackdrop');
  const zoomTriggers = document.querySelectorAll('.storyboard-zoom-btn');

  if (lightbox && lightboxImg && lightboxCaption) {
    const openLightbox = (src: string, caption?: string) => {
      lightboxImg.src = src;
      lightboxCaption.textContent = caption || 'SwitchCast Application View';
      lightbox.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.style.display = 'none';
      lightboxImg.src = '';
      document.body.style.overflow = '';
    };

    zoomTriggers.forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = trigger as HTMLElement;
        const src = target.getAttribute('data-zoom-src');
        const caption = target.getAttribute('data-zoom-caption');
        if (src) {
          openLightbox(src, caption || undefined);
        }
      });
    });

    lightboxCloseBtn?.addEventListener('click', closeLightbox);
    lightboxBackdrop?.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox.style.display === 'flex') {
        closeLightbox();
      }
    });
  }
</script>
