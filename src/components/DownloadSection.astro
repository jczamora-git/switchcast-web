---
import releaseData from '../data/release.json';
---

<section class="section download-section" id="download">
  <div class="container container-narrow">
    
    <div class="section-header reveal">
      <span class="section-tag">Get Started</span>
      <h2 class="section-title">Your Next Presentation<br />Starts Here.</h2>
      <p class="section-subtitle">
        Download SwitchCast for Windows and keep your next presentation moving.
      </p>
    </div>

    <!-- Main Download Card -->
    <div class="download-card glass-card reveal">
      
      <!-- Primary Action Block -->
      <div class="download-action-block">
        <a href={releaseData.downloadUrl} class="btn btn-primary btn-lg download-main-btn" download>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download SwitchCast</span>
        </a>

        <!-- Metadata Pill Row -->
        <div class="download-specs-row">
          <span>v{releaseData.version}</span>
          <span class="spec-dot">•</span>
          <span>{releaseData.platform}</span>
          <span class="spec-dot">•</span>
          <span>{releaseData.packageSize}</span>
          <span class="spec-dot">•</span>
          <span>Standalone ZIP</span>
        </div>
      </div>

      <!-- Compact 3-Step Setup -->
      <div class="setup-steps-wrapper">
        <span class="setup-header-label">QUICK SETUP</span>
        <div class="setup-steps-grid">
          <div class="setup-step">
            <span class="setup-num">1</span>
            <p>Download the ZIP archive</p>
          </div>
          <div class="setup-step">
            <span class="setup-num">2</span>
            <p>Extract the files anywhere</p>
          </div>
          <div class="setup-step">
            <span class="setup-num">3</span>
            <p>Open <strong>SwitchCast.exe</strong></p>
          </div>
        </div>
      </div>

      <!-- Secondary Links & Quiet Hash -->
      <div class="download-footer-links">
        <div class="sub-links-group">
          <a href={`/releases/${releaseData.releaseTag}`} class="quiet-link">
            Release Notes
          </a>
          <span class="link-divider">|</span>
          <a href="/releases" class="quiet-link view-all-link">
            View All Releases →
          </a>
        </div>

        <!-- Quiet Checksum Toggle -->
        <div class="quiet-checksum">
          <span class="hash-label">SHA-256:</span>
          <code class="hash-code" id="hashCodeText" title={releaseData.sha256}>
            {releaseData.sha256.slice(0, 12)}...{releaseData.sha256.slice(-8)}
          </code>
          <button class="hash-copy-btn" id="copyHashBtn" data-hash={releaseData.sha256} title="Copy SHA-256 Checksum">
            <span id="copyHashLabel">Copy</span>
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .download-section {
    position: relative;
  }

  .download-card {
    border: 1px solid var(--sc-border-base);
    padding: 3rem 2.5rem;
    text-align: center;
    box-shadow: var(--shadow-md);
  }

  .download-action-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 2.5rem;
  }

  .download-main-btn {
    padding: 0.95rem 2.5rem;
    font-size: 1.05rem;
    margin-bottom: 1rem;
    width: fit-content;
  }

  .download-specs-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sc-text-tertiary);
  }

  .spec-dot {
    color: var(--sc-border-base);
  }

  /* Compact 3-Step Setup */
  .setup-steps-wrapper {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--sc-border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    text-align: left;
  }

  .setup-header-label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sc-text-tertiary);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 1rem;
  }

  .setup-steps-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .setup-step {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .setup-num {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--sc-accent-soft);
    color: var(--sc-accent);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .setup-step p {
    font-size: 0.88rem;
    color: var(--sc-text-secondary);
    line-height: 1.35;
  }

  .setup-step p strong {
    color: #ffffff;
  }

  /* Secondary Links */
  .download-footer-links {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sc-border-subtle);
    font-size: 0.84rem;
  }

  .sub-links-group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .quiet-link {
    color: var(--sc-text-secondary);
    transition: color 0.2s ease;
  }

  .quiet-link:hover {
    color: #ffffff;
  }

  .link-divider {
    color: var(--sc-border-base);
  }

  .quiet-checksum {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--sc-text-tertiary);
  }

  .hash-code {
    color: var(--sc-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .hash-copy-btn {
    background: transparent;
    border: 1px solid var(--sc-border-base);
    color: var(--sc-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .hash-copy-btn:hover {
    color: #ffffff;
    border-color: var(--sc-accent);
  }

  @media (max-width: 640px) {
    .download-card {
      padding: 2rem 1.25rem;
    }

    .setup-steps-grid {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .download-footer-links {
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
    }

    .download-main-btn {
      width: 100%;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copyHashBtn');
  const copyLabel = document.getElementById('copyHashLabel');

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', () => {
      const hash = copyBtn.getAttribute('data-hash');
      if (hash && navigator.clipboard) {
        navigator.clipboard.writeText(hash).then(() => {
          copyLabel.textContent = 'Copied';
          setTimeout(() => {
            copyLabel.textContent = 'Copy';
          }, 2000);
        });
      }
    });
  }
</script>
