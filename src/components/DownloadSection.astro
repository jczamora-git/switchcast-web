---
import releaseData from '../data/release.json';
---

<section class="download-section" id="download" aria-labelledby="download-heading">
  <div class="site-container">
    
    <div class="download-header">
      <div class="download-header-left">
        <span class="editorial-tag">OFFICIAL RELEASE</span>
        <h2 id="download-heading" class="download-title">Download SwitchCast for Windows</h2>
      </div>
      <p class="download-subtitle">
        Free, standalone, and ready in seconds. No account required, no remote telemetry.
      </p>
    </div>

    <!-- Unified Editorial Download Container -->
    <div class="editorial-shell download-shell">
      
      <!-- Primary Action Row -->
      <div class="download-hero-cell">
        <a href={releaseData.downloadUrl} class="btn btn-primary btn-lg download-btn" download>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download for Windows</span>
        </a>

        <!-- Specs Line -->
        <div class="download-meta">
          <span>v{releaseData.version}</span>
          <span class="meta-dot">·</span>
          <span>Windows x64</span>
          <span class="meta-dot">·</span>
          <span>Setup Installer</span>
          <span class="meta-dot">·</span>
          <span>{releaseData.packageSize}</span>
        </div>

        {releaseData.portableDownloadUrl && (
          <div class="portable-row">
            <a href={releaseData.portableDownloadUrl} class="portable-link" download>
              Prefer portable version? Download ZIP ({releaseData.portableSize || 'Portable'})
            </a>
          </div>
        )}
      </div>

      <!-- Quick 3-Step Setup Matrix (Horizontal Hairline Dividers) -->
      <div class="download-steps-row">
        <div class="setup-cell">
          <span class="setup-num">01</span>
          <div class="setup-body">
            <span class="setup-title">Download</span>
            <span class="setup-desc">Get the official Windows installer above</span>
          </div>
        </div>
        <div class="setup-cell">
          <span class="setup-num">02</span>
          <div class="setup-body">
            <span class="setup-title">Install</span>
            <span class="setup-desc">Run setup wizard with one-click installation</span>
          </div>
        </div>
        <div class="setup-cell">
          <span class="setup-num">03</span>
          <div class="setup-body">
            <span class="setup-title">Present</span>
            <span class="setup-desc">Launch SwitchCast and start your clean broadcast</span>
          </div>
        </div>
      </div>

      <!-- Download Footer Bar (Release Notes + SHA-256 Checksum) -->
      <div class="download-footer-bar">
        <div class="footer-links">
          <a href={`/releases/${releaseData.releaseTag}/`} class="footer-link">
            v{releaseData.version} Release Notes
          </a>
          <span class="link-sep">/</span>
          <a href="/releases/" class="footer-link">
            All Releases →
          </a>
        </div>

        <div class="checksum-group">
          <span class="checksum-label">SHA-256:</span>
          <code class="checksum-code" title={releaseData.sha256}>
            {releaseData.sha256.slice(0, 10)}...{releaseData.sha256.slice(-8)}
          </code>
          <button type="button" class="checksum-copy-btn" id="copyHashBtn" data-hash={releaseData.sha256} aria-label="Copy SHA-256 Checksum">
            <span id="copyHashLabel">Copy</span>
          </button>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .download-section {
    padding: 6rem 0;
    position: relative;
    background: var(--sc-bg-primary);
  }

  .download-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.25rem;
    gap: 2rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--sc-border-base);
    padding-bottom: 1.5rem;
  }

  .download-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--sc-text-primary);
    letter-spacing: -0.025em;
    margin: 0.5rem 0 0 0;
  }

  .download-subtitle {
    max-width: 480px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--sc-text-secondary);
    margin: 0;
  }

  /* Unified Editorial Download Shell */
  .download-shell {
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-sm);
    background: var(--sc-bg-surface);
    overflow: hidden;
  }

  .download-hero-cell {
    padding: 3.5rem 2rem 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    border-bottom: 1px solid var(--sc-border-base);
    background: rgba(18, 18, 22, 0.4);
  }

  .download-btn {
    padding: 0.95rem 2.75rem;
    font-size: 1.05rem;
    margin-bottom: 1.25rem;
  }

  .download-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--sc-text-secondary);
  }

  .meta-dot {
    color: var(--sc-border-base);
  }

  .portable-row {
    margin-top: 1rem;
  }

  .portable-link {
    font-size: 0.82rem;
    color: var(--sc-text-secondary);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(255, 255, 255, 0.2);
    transition: color 0.15s ease;
  }

  .portable-link:hover {
    color: var(--sc-accent-coral);
    text-decoration-color: var(--sc-accent-coral);
  }

  /* 3-Step Setup Row with Hairline Dividers */
  .download-steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-bottom: 1px solid var(--sc-border-base);
  }

  .setup-cell {
    padding: 1.5rem 2rem;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-right: 1px solid var(--sc-border-base);
    background: rgba(14, 14, 18, 0.3);
  }

  .setup-cell:last-child {
    border-right: none;
  }

  .setup-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--sc-accent-coral);
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .setup-body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .setup-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--sc-text-primary);
  }

  .setup-desc {
    font-size: 0.82rem;
    color: var(--sc-text-secondary);
    line-height: 1.4;
  }

  /* Footer Bar */
  .download-footer-bar {
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    background: #0d0d12;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .footer-link {
    color: var(--sc-text-secondary);
    transition: color 0.15s ease;
  }

  .footer-link:hover {
    color: var(--sc-accent-coral);
  }

  .link-sep {
    color: var(--sc-border-base);
  }

  .checksum-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--sc-text-tertiary);
  }

  .checksum-code {
    color: var(--sc-text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--sc-border-base);
    padding: 0.15rem 0.45rem;
    border-radius: 3px;
  }

  .checksum-copy-btn {
    background: transparent;
    border: 1px solid var(--sc-border-base);
    color: var(--sc-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.18rem 0.5rem;
    border-radius: 3px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .checksum-copy-btn:hover {
    color: #ffffff;
    border-color: var(--sc-accent-coral);
  }

  @media (max-width: 840px) {
    .download-steps-row {
      grid-template-columns: 1fr;
    }

    .setup-cell {
      border-right: none;
      border-bottom: 1px solid var(--sc-border-base);
    }

    .setup-cell:last-child {
      border-bottom: none;
    }

    .download-footer-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
  }

  @media (max-width: 640px) {
    .download-section {
      padding: 4rem 0;
    }

    .download-hero-cell {
      padding: 2.5rem 1.25rem 2rem 1.25rem;
    }

    .download-btn {
      width: 100%;
    }

    .download-meta {
      font-size: 0.75rem;
      flex-wrap: wrap;
      justify-content: center;
    }

    .setup-cell {
      padding: 1.25rem 1.25rem;
    }
  }
</style>

<script>
  const copyBtn = document.getElementById('copyHashBtn');
  const copyLabel = document.getElementById('copyHashLabel');

  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', () => {
      const hash = copyBtn.getAttribute('data-hash');
      if (hash && navigator.clipboard) {
        navigator.clipboard.writeText(hash).then(() => {
          copyLabel.textContent = 'Copied';
          setTimeout(() => {
            copyLabel.textContent = 'Copy';
          }, 2000);
        });
      }
    });
  }
</script>
