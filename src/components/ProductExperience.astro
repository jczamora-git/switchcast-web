---
import InteractiveDemo from './demo/InteractiveDemo.astro';
import '../styles/interactive-demo.css';
---

<section class="section experience-section" id="demo">
  <!-- Legacy Anchor Alias Support for #experience -->
  <span id="experience" class="anchor-alias" aria-hidden="true"></span>

  <div class="container">
    
    <div class="section-header reveal">
      <span class="section-tag">Try It Yourself</span>
      <h2 class="section-title">Hands-on Interactive Simulator</h2>
      <p class="section-subtitle">
        Explore how SwitchCast works with a hands-on interactive demo. Test source queuing, live PowerPoint slide controls, background walk-in music, and presenter dock actions directly in your browser.
      </p>
    </div>

    <!-- Interactive Product Simulation -->
    <div class="reveal simulator-container">
      <InteractiveDemo />
    </div>

  </div>
</section>

<style>
  .experience-section {
    position: relative;
    scroll-margin-top: 104px;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .anchor-alias {
    position: absolute;
    top: 0;
    left: 0;
    scroll-margin-top: 104px;
    pointer-events: none;
    visibility: hidden;
  }

  .simulator-container {
    width: 100%;
  }
</style>
