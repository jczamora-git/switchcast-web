---
import InteractiveDemo from './demo/InteractiveDemo.astro';
import '../styles/interactive-demo.css';

const steps = [
  {
    num: "1",
    action: "SELECT",
    title: "Choose your sources",
    desc: "Pick the application windows, displays, images, or videos you want in your session queue."
  },
  {
    num: "2",
    action: "SHARE",
    title: "Share the output window",
    desc: "In Zoom, Teams, Google Meet, or OBS, share the single 'SwitchCast Presentation Output' window."
  },
  {
    num: "3",
    action: "SWITCH",
    title: "Switch without interruptions",
    desc: "Move between your queued sources using the dashboard, floating dock, or keyboard shortcuts."
  }
];
---

<section class="section experience-section" id="experience">
  <div class="container">
    
    <div class="section-header reveal">
      <span class="section-tag">Interactive Experience</span>
      <h2 class="section-title">Everything You Present.<br />One Shared Window.</h2>
      <p class="section-subtitle">
        Move between your apps, screens, and media while your audience stays focused on one continuous presentation.
      </p>
    </div>

    <!-- Interactive Product Simulation -->
    <div class="reveal" style="margin-bottom: 3.5rem;">
      <InteractiveDemo />
    </div>

    <!-- Three Simple Steps Below Showcase -->
    <div class="steps-row reveal">
      {steps.map((step) => (
        <div class="step-card">
          <div class="step-meta">
            <span class="step-badge">{step.action}</span>
            <span class="step-number">0{step.num}</span>
          </div>
          <h3 class="step-title">{step.title}</h3>
          <p class="step-desc">{step.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .experience-section {
    position: relative;
  }

  /* Three Steps Below */
  .steps-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .step-card {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0;
  }

  .step-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .step-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sc-accent);
    letter-spacing: 0.08em;
  }

  .step-number {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--sc-border-base);
  }

  .step-title {
    font-size: 1.15rem;
    color: #ffffff;
    margin-bottom: 0.45rem;
  }

  .step-desc {
    font-size: 0.92rem;
    color: var(--sc-text-secondary);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .steps-row {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .step-card {
      padding: 1rem 0;
      border-bottom: 1px solid var(--sc-border-subtle);
    }
  }
</style>
