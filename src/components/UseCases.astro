---
import { USE_CASES } from '../data/features';
---

<section class="section use-cases-section" id="use-cases">
  <div class="container">
    
    <div class="section-header reveal">
      <span class="section-tag">Target Audiences</span>
      <h2 class="section-title">Designed for Anyone Who Presents on Windows</h2>
      <p class="section-subtitle">
        Whether demonstrating complex distributed software, lecturing university classes, or presenting quarterly executive financials, SwitchCast keeps your audience immersed.
      </p>
    </div>

    <div class="use-cases-grid">
      {USE_CASES.map((uc) => (
        <div class="use-case-card glass-card hover-lift reveal" id={`uc-${uc.id}`}>
          <div class="uc-header">
            <span class="uc-subtitle">{uc.subtitle}</span>
            <h3 class="uc-title">{uc.title}</h3>
          </div>

          <p class="uc-desc">{uc.description}</p>

          <div class="uc-sources-box">
            <span class="uc-sources-label">TYPICAL QUEUE:</span>
            <div class="uc-source-tags">
              {uc.sourcesExample.map((s) => (
                <span class="uc-pill">{s}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .use-cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .use-case-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--sc-border-subtle);
  }

  .uc-header {
    margin-bottom: 1.25rem;
  }

  .uc-subtitle {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sc-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .uc-title {
    font-size: 1.4rem;
    color: #ffffff;
  }

  .uc-desc {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--sc-text-secondary);
    margin-bottom: 1.75rem;
    flex: 1;
  }

  .uc-sources-box {
    background: var(--sc-bg-surface);
    border: 1px solid var(--sc-border-subtle);
    padding: 1rem 1.25rem;
    border-radius: var(--radius-sm);
  }

  .uc-sources-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--sc-text-tertiary);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.6rem;
  }

  .uc-source-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .uc-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--sc-bg-surface-elevated);
    border: 1px solid var(--sc-border-base);
    color: var(--sc-text-primary);
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-xs);
  }

  @media (max-width: 768px) {
    .use-cases-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
