---
import { FAQS } from '../data/features';
---

<section class="section faq-section" id="faq">
  <div class="container-narrow">
    
    <div class="section-header reveal">
      <span class="section-tag">Frequently Asked Questions</span>
      <h2 class="section-title">Everything You Need to Know</h2>
      <p class="section-subtitle">
        Answers to common questions regarding SwitchCast's architecture, meeting software compatibility, and offline security model.
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="faq-list reveal">
      {FAQS.map((faq, index) => (
        <details class="faq-item glass-card" id={`faq-${index}`}>
          <summary class="faq-question">
            <span class="faq-q-text">{faq.question}</span>
            <span class="faq-icon-wrapper" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="faq-chevron">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    border: 1px solid var(--sc-border-subtle);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all 0.25s ease;
  }

  .faq-item[open] {
    border-color: var(--sc-border-base);
    background: var(--sc-bg-surface);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: #ffffff;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sc-bg-surface-elevated);
    color: var(--sc-accent);
    flex-shrink: 0;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), background-color 0.2s ease;
  }

  .faq-item[open] .faq-icon-wrapper {
    transform: rotate(180deg);
    background: var(--sc-accent);
    color: #08080a;
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem 1.5rem;
    color: var(--sc-text-secondary);
    font-size: 0.95rem;
    line-height: 1.65;
    border-top: 1px solid transparent;
  }

  .faq-item[open] .faq-answer {
    border-top: 1px solid var(--sc-border-subtle);
    padding-top: 1.25rem;
  }

  @media (max-width: 768px) {
    .faq-question {
      padding: 1rem 1.25rem;
      font-size: 0.98rem;
    }

    .faq-answer {
      padding: 0 1.25rem 1.25rem 1.25rem;
      font-size: 0.9rem;
    }
  }
</style>
