---
// SwitchCast Product Capabilities — Continuous Editorial Storyboard Grid
// Raycast-inspired unified grid: shared 1px dividers, asymmetric composition, genuine assets
---

<section class="section capabilities-section" id="capabilities">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header reveal">
      <span class="section-tag">Product Capabilities</span>
      <h2 class="section-title">Engineered for Presentations<br />That Don't Stop</h2>
      <p class="section-subtitle">
        Everything you need to present multiple applications, slide decks, media, and cameras from a single shared window.
      </p>
    </div>

    <!-- Unified Continuous Editorial Grid Shell (No isolated floating cards) -->
    <div class="editorial-shell reveal">
      <div class="editorial-grid">
        
        <!-- ROW 1, ITEM 1 (Col Span 8): 01 — ONE SHARED WINDOW -->
        <div class="editorial-cell cell-span-8 border-right border-bottom">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">01</span>
              <span class="cell-cat">ONE SHARED WINDOW</span>
            </div>
            <h3 class="cell-headline">Share once. Present anything.</h3>
            <p class="cell-desc">
              Keep one window shared while moving between everything you've prepared. Your audience never sees you stop and restart screen share.
            </p>
          </div>
          <div class="cell-visual visual-lead">
            <img 
              src="/illustrations/single-output.svg" 
              alt="Multiple application windows routing into a single presentation output" 
              class="editorial-img" 
              loading="lazy" 
              width="800" 
              height="500" 
            />
          </div>
        </div>

        <!-- ROW 1, ITEM 2 (Col Span 4): 02 — EXTERNAL DISPLAYS -->
        <div class="editorial-cell cell-span-4 border-bottom">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">02</span>
              <span class="cell-cat">EXTERNAL DISPLAYS</span>
            </div>
            <h3 class="cell-headline">Present beyond your desktop.</h3>
            <p class="cell-desc">
              Use a second screen or projector while keeping your controls on your own display.
            </p>
          </div>
          <div class="cell-visual visual-compact">
            <img 
              src="/illustrations/external-display.svg" 
              alt="Conceptual routing diagram sending clean presentation output to external screen" 
              class="editorial-img" 
              loading="lazy" 
              width="800" 
              height="500" 
            />
          </div>
        </div>

        <!-- ROW 2, ITEM 3 (Col Span 4): 03 — PRESENTER DOCK -->
        <div class="editorial-cell cell-span-4 border-right border-bottom">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">03</span>
              <span class="cell-cat">PRESENTER DOCK</span>
            </div>
            <h3 class="cell-headline">Stay in control.</h3>
            <p class="cell-desc">
              Switch sources, pause, and blackout without returning to the main window.
            </p>
          </div>
          <div class="cell-visual visual-dock-showcase">
            <picture>
              <source srcset="/screenshots/presenter-dock.webp" type="image/webp" />
              <img 
                src="/screenshots/presenter-dock.png" 
                alt="SwitchCast Floating Presenter Dock with source switching, pause, and blackout controls" 
                class="editorial-img dock-screenshot" 
                loading="lazy" 
              />
            </picture>
          </div>
        </div>

        <!-- ROW 2, ITEM 4 (Col Span 8): 04 — SOURCE SWITCHING -->
        <div class="editorial-cell cell-span-8 border-bottom">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">04</span>
              <span class="cell-cat">SOURCE SWITCHING</span>
            </div>
            <h3 class="cell-headline">Everything ready. One smooth flow.</h3>
            <p class="cell-desc">
              Prepare windows, presentations, images, and videos before you go live. Cut between sources with zero latency.
            </p>
          </div>
          <div class="cell-visual visual-lead">
            <img 
              src="/illustrations/source-switching.svg" 
              alt="Source switching sequence transitioning smoothly to presentation output" 
              class="editorial-img" 
              loading="lazy" 
              width="800" 
              height="500" 
            />
          </div>
        </div>

        <!-- ROW 3, ITEM 5 (Col Span 6): 05 — POWERPOINT & MEDIA -->
        <div class="editorial-cell cell-span-6 border-right">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">05</span>
              <span class="cell-cat">POWERPOINT & MEDIA</span>
            </div>
            <h3 class="cell-headline">More than screen sharing.</h3>
            <p class="cell-desc">
              Present slide decks, videos, and images through one consistent output.
            </p>
          </div>
          <div class="cell-visual visual-medium">
            <picture>
              <source srcset="/screenshots/powerpoint.webp" type="image/webp" />
              <img 
                src="/screenshots/powerpoint.png" 
                alt="Presentation Output window rendering presentation slides cleanly" 
                class="editorial-img screenshot-framed" 
                loading="lazy" 
              />
            </picture>
          </div>
        </div>

        <!-- ROW 3, ITEM 6 (Col Span 6): 06 — BACKGROUND MUSIC -->
        <div class="editorial-cell cell-span-6">
          <div class="cell-copy">
            <div class="cell-meta">
              <span class="cell-num">06</span>
              <span class="cell-cat">BACKGROUND MUSIC</span>
            </div>
            <h3 class="cell-headline">Set the mood. Keep it playing.</h3>
            <p class="cell-desc">
              Manage presentation music independently from your visual sources.
            </p>
          </div>
          <div class="cell-visual visual-medium">
            <picture>
              <source srcset="/screenshots/music-playlists.webp" type="image/webp" />
              <img 
                src="/screenshots/music-playlists.png" 
                alt="SwitchCast Music and Playlists tab with audio queue and volume slider" 
                class="editorial-img screenshot-framed" 
                loading="lazy" 
              />
            </picture>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .capabilities-section {
    position: relative;
    scroll-margin-top: 104px;
    padding-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  /* Modular 12-Column CSS Grid Shell */
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    background: transparent;
  }

  /* Grid Cell Base */
  .editorial-cell {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: rgba(13, 14, 20, 0.7);
    position: relative;
    transition: background 0.25s ease;
  }

  .editorial-cell:hover {
    background: rgba(18, 20, 29, 0.85);
  }

  /* Asymmetric Column Spans */
  .cell-span-8 {
    grid-column: span 8;
  }

  .cell-span-6 {
    grid-column: span 6;
  }

  .cell-span-4 {
    grid-column: span 4;
  }

  /* Shared 1px Dividers (No Doubled Borders) */
  .border-right {
    border-right: 1px solid var(--sc-border-base);
  }

  .border-bottom {
    border-bottom: 1px solid var(--sc-border-base);
  }

  /* Cell Copy Area */
  .cell-copy {
    padding: clamp(1.4rem, 2.5vw, 2rem);
  }

  .cell-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.65rem;
  }

  .cell-num {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--sc-accent);
    background: var(--sc-accent-soft);
    padding: 0.12rem 0.4rem;
    border-radius: 2px;
  }

  .cell-cat {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--sc-text-tertiary);
    letter-spacing: 0.08em;
  }

  .cell-headline {
    font-family: var(--font-display);
    font-size: clamp(1.12rem, 1.6vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
    margin-bottom: 0.45rem;
    line-height: 1.28;
  }

  .cell-desc {
    font-size: 0.88rem;
    color: var(--sc-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Visual Presentation Canvases */
  .cell-visual {
    background: #090a0f;
    border-top: 1px solid var(--sc-border-subtle);
    padding: 1rem 1.25rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    min-height: 220px;
    position: relative;
    overflow: hidden;
  }

  .visual-lead {
    min-height: 250px;
  }

  .visual-compact {
    min-height: 220px;
  }

  .visual-medium {
    min-height: 220px;
  }

  .visual-dock-showcase {
    min-height: 160px;
    padding: 1.5rem 1rem;
    background: radial-gradient(circle at center, rgba(255, 122, 89, 0.05) 0%, #090a0f 80%);
  }

  .editorial-img {
    width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: contain;
    display: block;
    border-radius: 2px;
    transition: transform 0.3s ease;
  }

  .editorial-cell:hover .editorial-img {
    transform: scale(1.015);
  }

  .dock-screenshot {
    max-height: 70px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .screenshot-framed {
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  /* Responsive Rules */
  @media (max-width: 990px) {
    .editorial-grid {
      grid-template-columns: 1fr;
    }

    .cell-span-8,
    .cell-span-6,
    .cell-span-4 {
      grid-column: span 1;
    }

    .border-right {
      border-right: none;
    }

    .editorial-cell {
      border-bottom: 1px solid var(--sc-border-base);
    }

    .editorial-cell:last-child {
      border-bottom: none;
    }

    .cell-copy {
      padding: 1.25rem;
    }

    .cell-visual {
      min-height: 180px;
      padding: 0.85rem;
    }
  }
</style>
