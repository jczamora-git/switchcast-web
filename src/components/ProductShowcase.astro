---
// Authentic SwitchCast Cinematic Product Showcase
// Real-world presenter workflow: "One Meeting. Multiple Sources. One Shared Window."
// Fictional Business Scenario: Quarterly Business Review
---

<section class="section showcase-section" id="showcase">
  <div class="container">
    
    <!-- Section Header -->
    <div class="section-header reveal">
      <span class="section-tag">Cinematic Showcase</span>
      <h2 class="section-title">One Meeting. Multiple Sources.<br />One Shared Window.</h2>
      <p class="section-subtitle">
        See how SwitchCast keeps your audience focused on a single presentation window while you switch smoothly between slides, live apps, videos, and cameras.
      </p>
    </div>

    <!-- Cinematic Product Stage -->
    <div class="showcase-stage-wrapper reveal" id="showcaseStage">
      
      <!-- Ambient Coral Glow Behind Product -->
      <div class="stage-ambient-glow" aria-hidden="true"></div>

      <!-- Desktop & Responsive Presentation Canvas -->
      <div class="showcase-stage">
        
        <!-- ==================== SCENE 01: PREPARE ==================== -->
        <div class="showcase-scene active" data-scene="0" id="scene-0">
          <div class="scene-visual-wrapper">
            <!-- SwitchCast Session Manager Window -->
            <div class="win-window control-manager-window focus-glow">
              <div class="win-titlebar">
                <div class="win-title">
                  <img src="/assets/switchcast-logo.svg" alt="" width="14" height="14" />
                  <span>SwitchCast — Session Manager (Quarterly Business Review)</span>
                </div>
                <div class="win-controls" aria-hidden="true">
                  <span class="win-btn win-min"></span>
                  <span class="win-btn win-max"></span>
                  <span class="win-btn win-close"></span>
                </div>
              </div>

              <div class="manager-body">
                <div class="manager-sidebar">
                  <span class="sidebar-label">SESSION QUEUE</span>
                  <div class="source-item active">
                    <span class="source-icon">📊</span>
                    <div class="source-info">
                      <span class="source-name">Quarterly Review.pptx</span>
                      <span class="source-detail">PowerPoint • 18 Slides</span>
                    </div>
                    <span class="status-badge live">LIVE</span>
                  </div>

                  <div class="source-item next-item">
                    <span class="source-icon">🌐</span>
                    <div class="source-info">
                      <span class="source-name">Sales Dashboard — Browser</span>
                      <span class="source-detail">Edge • Live Web App</span>
                    </div>
                    <span class="status-badge next">NEXT</span>
                  </div>

                  <div class="source-item">
                    <span class="source-icon">🎬</span>
                    <div class="source-info">
                      <span class="source-name">Product Walkthrough.mp4</span>
                      <span class="source-detail">Video Media • 03:45</span>
                    </div>
                    <span class="status-badge">READY</span>
                  </div>

                  <div class="source-item">
                    <span class="source-icon">📷</span>
                    <div class="source-info">
                      <span class="source-name">Presenter Camera</span>
                      <span class="source-detail">Webcam • 1080p 60fps</span>
                    </div>
                    <span class="status-badge">READY</span>
                  </div>
                </div>

                <div class="manager-preview-pane">
                  <div class="preview-header">
                    <span class="preview-title">NEXT SOURCE STAGING</span>
                    <span class="preview-mode-tag">Active + Live Mode</span>
                  </div>
                  <div class="staged-preview-box">
                    <div class="browser-mockup-header">
                      <span class="browser-dot"></span><span class="browser-dot"></span><span class="browser-dot"></span>
                      <span class="browser-url">app.company.internal/analytics/dashboard</span>
                    </div>
                    <div class="browser-mockup-content">
                      <div class="mock-dash-metric">
                        <span class="mock-label">MONTHLY REVENUE</span>
                        <span class="mock-value">$428,500</span>
                      </div>
                      <div class="mock-dash-bars">
                        <div class="mock-bar" style="height: 45%;"></div>
                        <div class="mock-bar" style="height: 65%;"></div>
                        <div class="mock-bar" style="height: 85%;"></div>
                        <div class="mock-bar active" style="height: 100%;"></div>
                      </div>
                    </div>
                  </div>
                  <div class="preview-actions-bar">
                    <span class="cue-pill">Press Ctrl+Shift+Right to switch live</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== SCENE 02: SHARE ONCE ==================== -->
        <div class="showcase-scene" data-scene="1" id="scene-1">
          <div class="scene-visual-wrapper">
            <!-- Simulated Presentation Output Window -->
            <div class="win-window output-window focus-glow">
              <div class="win-titlebar">
                <div class="win-title">
                  <span class="live-dot-mini" aria-hidden="true"></span>
                  <span>SwitchCast Presentation Output — 1920 × 1080 (Audience View)</span>
                </div>
                <div class="win-controls" aria-hidden="true">
                  <span class="win-btn win-min"></span>
                  <span class="win-btn win-max"></span>
                  <span class="win-btn win-close"></span>
                </div>
              </div>

              <div class="output-canvas-inner">
                <!-- Clean Executive Business Slide -->
                <div class="slide-deck-preview">
                  <div class="slide-header">
                    <span class="slide-kicker">GLOBAL BUSINESS REVIEW</span>
                    <span class="slide-page-badge">Slide 04 of 18</span>
                  </div>
                  <h4 class="slide-headline">Q4 Business Performance &amp; Revenue Growth</h4>
                  
                  <div class="slide-cards-row">
                    <div class="slide-mini-card">
                      <span class="card-metric">+38% YoY</span>
                      <span class="card-caption">Revenue Expansion</span>
                    </div>
                    <div class="slide-mini-card">
                      <span class="card-metric">94%</span>
                      <span class="card-caption">Customer Retention</span>
                    </div>
                    <div class="slide-mini-card">
                      <span class="card-metric">12,400+</span>
                      <span class="card-caption">Enterprise Teams</span>
                    </div>
                  </div>

                  <!-- Executive Growth Visual -->
                  <div class="slide-chart-preview">
                    <div class="chart-col">
                      <div class="chart-bar" style="height: 45%;"></div>
                      <span class="chart-label">Q1</span>
                    </div>
                    <div class="chart-col">
                      <div class="chart-bar" style="height: 60%;"></div>
                      <span class="chart-label">Q2</span>
                    </div>
                    <div class="chart-col">
                      <div class="chart-bar" style="height: 78%;"></div>
                      <span class="chart-label">Q3</span>
                    </div>
                    <div class="chart-col active">
                      <div class="chart-bar" style="height: 98%;"></div>
                      <span class="chart-label">Q4</span>
                    </div>
                  </div>
                </div>

                <!-- Clean HUD Watermark -->
                <div class="output-hud-pill">
                  <span class="hud-indicator">● LIVE AUDIENCE VIEW</span>
                  <span class="hud-source">PowerPoint — Quarterly_Review.pptx</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== SCENE 03: SWITCH SEAMLESSLY ==================== -->
        <div class="showcase-scene" data-scene="2" id="scene-2">
          <div class="scene-visual-wrapper">
            <!-- Output Window Stays Stable; Inside Cycles Multi-Source -->
            <div class="win-window output-window focus-glow">
              <div class="win-titlebar">
                <div class="win-title">
                  <span class="live-dot-mini" aria-hidden="true"></span>
                  <span>SwitchCast Presentation Output — Same Shared Window (Live Switch)</span>
                </div>
                <div class="win-controls" aria-hidden="true">
                  <span class="win-btn win-min"></span>
                  <span class="win-btn win-max"></span>
                  <span class="win-btn win-close"></span>
                </div>
              </div>

              <div class="output-canvas-inner multi-switch-canvas">
                <!-- Active Switched Source View: Live Web Dashboard -->
                <div class="active-source-surface" id="switchCycleSurface">
                  
                  <!-- View A: Browser Dashboard -->
                  <div class="switch-slide-panel active" id="switch-panel-app">
                    <div class="browser-app-window">
                      <div class="browser-bar">
                        <span class="browser-url-pill">🔒 internal.acme.com/exec-kpi</span>
                        <span class="browser-tag">LIVE APPLICATION</span>
                      </div>
                      <div class="dash-kpi-grid">
                        <div class="dash-card">
                          <span class="dash-num">$1,420,000</span>
                          <span class="dash-lbl">Quarterly Pipeline</span>
                        </div>
                        <div class="dash-card">
                          <span class="dash-num">99.8%</span>
                          <span class="dash-lbl">Service Uptime</span>
                        </div>
                        <div class="dash-card">
                          <span class="dash-num">48,200</span>
                          <span class="dash-lbl">Active Users</span>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- View B: Product Walkthrough Video (Alternate cycle) -->
                  <div class="switch-slide-panel" id="switch-panel-video">
                    <div class="video-player-preview">
                      <div class="video-viewport">
                        <span class="video-play-glyph">▶</span>
                        <span class="video-tag">PRODUCT WALKTHROUGH DEMO</span>
                      </div>
                      <div class="video-scrubber">
                        <span class="time-readout">01:42 / 03:45</span>
                        <div class="scrub-track"><div class="scrub-fill" style="width: 48%;"></div></div>
                      </div>
                    </div>
                  </div>

                  <!-- View C: Presenter Camera (Alternate cycle) -->
                  <div class="switch-slide-panel" id="switch-panel-camera">
                    <div class="camera-feed-preview">
                      <div class="camera-frame">
                        <div class="camera-avatar-box">
                          <span class="avatar-glyph">👤</span>
                          <span class="camera-presenter-name">Sarah Jenkins</span>
                          <span class="camera-presenter-role">VP Product Management</span>
                        </div>
                        <span class="camera-hud-badge">1080p 60FPS • STUDIO CAMERA</span>
                      </div>
                    </div>
                  </div>

                </div>

                <!-- HUD Pill Indicating Seamless Transition -->
                <div class="output-hud-pill">
                  <span class="hud-indicator switched">● SEAMLESS SOURCE TRANSITION</span>
                  <span class="hud-source" id="switchHudLabel">Sales Dashboard — Chrome</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ==================== SCENE 04: STAY IN CONTROL ==================== -->
        <div class="showcase-scene" data-scene="3" id="scene-3">
          <div class="scene-visual-wrapper control-scene-visual">
            
            <!-- Output Background Layer With Optional Blackout Effect -->
            <div class="control-backdrop-output">
              <div class="win-window output-mini-bg">
                <div class="win-titlebar">
                  <div class="win-title">
                    <span class="live-dot-mini"></span>
                    <span>SwitchCast Presentation Output</span>
                  </div>
                </div>
                <div class="output-mini-body">
                  <div class="mini-slide-content">
                    <span class="mini-kicker">KEYNOTE PRESENTATION</span>
                    <span class="mini-title">Q4 Business Performance &amp; Revenue Growth</span>
                  </div>
                  <!-- Blackout Curtain Overlay -->
                  <div class="privacy-blackout-curtain" id="showcaseBlackoutCurtain">
                    <span class="curtain-label">PRIVACY BLACKOUT ACTIVE</span>
                    <span class="curtain-sub">Audience sees 100% black • Audio muted</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Front-and-Center Floating Presenter Dock -->
            <div class="dock-hero-showcase">
              <div class="dock-floating-bar">
                <div class="dock-drag-grip" title="Drag anywhere on your workspace">⋮⋮</div>
                
                <div class="dock-source-indicator">
                  <span class="dock-source-type">LIVE</span>
                  <span class="dock-source-label">Quarterly Review.pptx</span>
                </div>

                <div class="dock-divider"></div>

                <!-- Slide Navigation Controls -->
                <div class="dock-control-group">
                  <button class="dock-btn-showcase" title="Previous Slide">‹</button>
                  <span class="dock-slide-pill">Slide 4 / 18</span>
                  <button class="dock-btn-showcase" title="Next Slide">›</button>
                </div>

                <div class="dock-divider"></div>

                <!-- Freeze-Frame and Blackout Controls -->
                <div class="dock-action-group">
                  <div class="dock-action-item">
                    <span class="dock-action-badge pause">PAUSE</span>
                    <span class="dock-action-text">Freeze Frame</span>
                  </div>
                  <div class="dock-action-item active-blackout-pill" id="dockBlackoutAction">
                    <span class="dock-action-badge blackout">BLACKOUT</span>
                    <span class="dock-action-text">Privacy Curtain</span>
                  </div>
                </div>

                <div class="dock-divider"></div>

                <div class="dock-music-pill">
                  <span>🎵 Walk-in Playlist (Active)</span>
                </div>
              </div>

              <!-- Explanation Callout -->
              <div class="dock-callout-pill">
                <span>The dock stays on top of your windows • Never visible to your meeting audience</span>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- Showcase Captions Area (Dynamic Storyboard Text) -->
      <div class="showcase-caption-bar">
        <div class="caption-tag-pill" id="showcaseSceneTag">01 / PREPARE</div>
        <h3 class="caption-headline" id="showcaseSceneHeadline">Everything ready.</h3>
        <p class="caption-desc" id="showcaseSceneDesc">
          Keep your presentation materials in one place. Queue slides, live applications, video media, and cameras before your session begins.
        </p>
      </div>

      <!-- Minimal Scene Selector Navigation Tabs -->
      <div class="showcase-nav-bar" role="tablist" aria-label="Presentation Showcase Scenes">
        <div class="scene-tabs-group">
          <button class="scene-tab active" data-tab="0" role="tab" aria-selected="true" id="tab-0">
            <span class="tab-num">01</span>
            <span class="tab-label">Prepare</span>
            <div class="tab-progress-bar" aria-hidden="true"></div>
          </button>
          <button class="scene-tab" data-tab="1" role="tab" aria-selected="false" id="tab-1">
            <span class="tab-num">02</span>
            <span class="tab-label">Share</span>
            <div class="tab-progress-bar" aria-hidden="true"></div>
          </button>
          <button class="scene-tab" data-tab="2" role="tab" aria-selected="false" id="tab-2">
            <span class="tab-num">03</span>
            <span class="tab-label">Switch</span>
            <div class="tab-progress-bar" aria-hidden="true"></div>
          </button>
          <button class="scene-tab" data-tab="3" role="tab" aria-selected="false" id="tab-3">
            <span class="tab-num">04</span>
            <span class="tab-label">Control</span>
            <div class="tab-progress-bar" aria-hidden="true"></div>
          </button>
        </div>

        <!-- Autoplay Controls -->
        <button class="showcase-playback-btn" id="showcasePlayPause" aria-label="Pause Auto-advance" title="Pause / Play Auto-advance">
          <svg class="icon-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16"></rect>
            <rect x="14" y="4" width="4" height="16"></rect>
          </svg>
          <svg class="icon-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="display: none;">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>
      </div>

    </div>

  </div>
</section>

<style>
  .showcase-section {
    position: relative;
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    scroll-margin-top: 104px;
  }

  .showcase-stage-wrapper {
    position: relative;
    max-width: 1040px;
    margin: 0 auto;
  }

  /* Ambient Glow Behind Product */
  .stage-ambient-glow {
    position: absolute;
    top: 15%;
    left: 20%;
    right: 20%;
    height: 60%;
    background: radial-gradient(ellipse, rgba(255, 122, 89, 0.16) 0%, rgba(255, 122, 89, 0.04) 50%, transparent 75%);
    filter: blur(50px);
    pointer-events: none;
    z-index: 0;
  }

  /* Presentation Stage Container */
  .showcase-stage {
    position: relative;
    width: 100%;
    height: 480px;
    background: linear-gradient(180deg, rgba(18, 19, 25, 0.95) 0%, rgba(13, 14, 18, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-lg);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.65), 0 1px 2px rgba(255, 255, 255, 0.05);
    overflow: hidden;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Scene Transitions */
  .showcase-scene {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem;
    opacity: 0;
    pointer-events: none;
    transform: translateY(10px) scale(0.985);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-scene.active {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0) scale(1);
  }

  .scene-visual-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Authentic Windows Window Frame */
  .win-window {
    width: 100%;
    max-width: 820px;
    height: 100%;
    max-height: 400px;
    background: #0d0e12;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.7);
  }

  .focus-glow {
    border-color: rgba(255, 122, 89, 0.35);
    box-shadow: 0 18px 48px rgba(0, 0, 0, 0.7), 0 0 30px rgba(255, 122, 89, 0.12);
  }

  /* Windows Titlebar */
  .win-titlebar {
    height: 32px;
    background: #16171e;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.85rem;
    user-select: none;
    flex-shrink: 0;
  }

  .win-title {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    color: var(--sc-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .live-dot-mini {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ff3b30;
    box-shadow: 0 0 6px #ff3b30;
  }

  .win-controls {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .win-btn {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.18);
  }

  .win-close {
    background: rgba(255, 255, 255, 0.28);
  }

  /* --- SCENE 1: SESSION MANAGER --- */
  .control-manager-window {
    max-width: 860px;
  }

  .manager-body {
    display: grid;
    grid-template-columns: 280px 1fr;
    height: calc(100% - 32px);
    background: #0f1016;
  }

  .manager-sidebar {
    background: #12131b;
    border-right: 1px solid rgba(255, 255, 255, 0.08);
    padding: 1rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sidebar-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--sc-text-tertiary);
    letter-spacing: 0.08em;
    margin-bottom: 0.25rem;
    padding-left: 0.25rem;
  }

  .source-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 6px;
    padding: 0.55rem 0.65rem;
    transition: all 0.2s ease;
  }

  .source-item.active {
    background: rgba(255, 122, 89, 0.12);
    border-color: rgba(255, 122, 89, 0.4);
  }

  .source-item.next-item {
    border-color: rgba(255, 255, 255, 0.18);
  }

  .source-icon {
    font-size: 1.1rem;
    line-height: 1;
  }

  .source-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .source-name {
    font-size: 0.78rem;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .source-detail {
    font-size: 0.68rem;
    color: var(--sc-text-secondary);
  }

  .status-badge {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 700;
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--sc-text-tertiary);
  }

  .status-badge.live {
    background: #ff3b30;
    color: #ffffff;
  }

  .status-badge.next {
    background: var(--sc-accent);
    color: #08080a;
  }

  .manager-preview-pane {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .preview-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .preview-title {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--sc-text-secondary);
    letter-spacing: 0.06em;
  }

  .preview-mode-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--sc-accent);
    background: var(--sc-accent-soft);
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    font-weight: 600;
  }

  .staged-preview-box {
    background: #090a0e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    overflow: hidden;
    margin: 1rem 0;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .browser-mockup-header {
    height: 24px;
    background: #14151e;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .browser-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
  }

  .browser-url {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--sc-text-tertiary);
    margin-left: 0.45rem;
  }

  .browser-mockup-content {
    flex: 1;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .mock-dash-metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .mock-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--sc-text-tertiary);
  }

  .mock-value {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
  }

  .mock-dash-bars {
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    height: 60px;
  }

  .mock-bar {
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px 2px 0 0;
  }

