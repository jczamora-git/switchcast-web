<script>
  // Autoplay & Scene Controller for Real-World Presenter Showcase
  const scenes = [
    {
      tag: '01 / PREPARE',
      headline: 'Everything ready.',
      desc: 'Keep your presentation materials in one place. Queue slides, live applications, video media, and cameras before your session begins.'
    },
    {
      tag: '02 / SHARE',
      headline: 'Share once.',
      desc: 'Your audience follows one presentation window. Share the SwitchCast Output in your meeting software, and never fumble with screen share again.'
    },
    {
      tag: '03 / SWITCH',
      headline: 'Switch seamlessly.',
      desc: 'Move between slides, apps, videos, and cameras without changing your screen share. The outer presentation window never interrupts.'
    },
    {
      tag: '04 / CONTROL',
      headline: 'Stay in control.',
      desc: 'Pause, switch, or hide your presentation without losing your flow. The Floating Presenter Dock hovers cleanly over your work.'
    }
  ];

  let currentScene = 0;
  let isPlaying = true;
  let timer: any = null;
  const SCENE_DURATION = 4500;

  const stageWrapper = document.getElementById('showcaseStage');
  const sceneElements = document.querySelectorAll('.showcase-scene');
  const tabElements = document.querySelectorAll('.scene-tab');
  const tagEl = document.getElementById('showcaseSceneTag');
  const headlineEl = document.getElementById('showcaseSceneHeadline');
  const descEl = document.getElementById('showcaseSceneDesc');
  const playPauseBtn = document.getElementById('showcasePlayPause');
  const pauseIcon = playPauseBtn?.querySelector('.icon-pause') as HTMLElement;
  const playIcon = playPauseBtn?.querySelector('.icon-play') as HTMLElement;

  // Scene 3 Multi-Source Cycle
  const switchPanels = [
    { id: 'switch-panel-app', label: 'Sales Dashboard — Edge Browser' },
    { id: 'switch-panel-video', label: 'Product Walkthrough — Media Video' },
    { id: 'switch-panel-camera', label: 'Presenter Camera — HD Studio Webcam' }
  ];
  let switchIndex = 0;
  let switchInterval: any = null;

  const setScene = (index: number) => {
    currentScene = index;

    // Update scenes
    sceneElements.forEach((el, idx) => {
      el.classList.toggle('active', idx === currentScene);
    });

    // Update tabs
    tabElements.forEach((tab, idx) => {
      const isActive = idx === currentScene;
      tab.classList.toggle('active', isActive);
      tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
    });

    // Update captions
    const data = scenes[currentScene];
    if (tagEl) tagEl.textContent = data.tag;
    if (headlineEl) headlineEl.textContent = data.headline;
    if (descEl) descEl.textContent = data.desc;

    // Trigger Scene 3 sub-cycle if active
    if (currentScene === 2) {
      startSwitchCycle();
    } else {
      stopSwitchCycle();
    }

    // Trigger Scene 4 blackout curtain demonstration briefly
    if (currentScene === 3) {
      triggerBlackoutDemo();
    }
  };

  const startSwitchCycle = () => {
    stopSwitchCycle();
    switchIndex = 0;
    updateSwitchUI();
    switchInterval = setInterval(() => {
      switchIndex = (switchIndex + 1) % switchPanels.length;
      updateSwitchUI();
    }, 1500);
  };

  const stopSwitchCycle = () => {
    if (switchInterval) {
      clearInterval(switchInterval);
      switchInterval = null;
    }
  };

  const updateSwitchUI = () => {
    const activeData = switchPanels[switchIndex];
    switchPanels.forEach((p, idx) => {
      const el = document.getElementById(p.id);
      if (el) el.classList.toggle('active', idx === switchIndex);
    });
    const labelEl = document.getElementById('switchHudLabel');
    if (labelEl) labelEl.textContent = activeData.label;
  };

  const triggerBlackoutDemo = () => {
    const curtain = document.getElementById('showcaseBlackoutCurtain');
    if (curtain) {
      curtain.classList.remove('active');
      setTimeout(() => {
        curtain.classList.add('active');
        setTimeout(() => {
          curtain.classList.remove('active');
        }, 1800);
      }, 800);
    }
  };

  const nextScene = () => {
    const next = (currentScene + 1) % scenes.length;
    setScene(next);
  };

  const startTimer = () => {
    stopTimer();
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      isPlaying = false;
      updatePlayPauseUI();
      return;
    }
    timer = setInterval(nextScene, SCENE_DURATION);
  };

  const stopTimer = () => {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  };

  const updatePlayPauseUI = () => {
    if (pauseIcon && playIcon) {
      pauseIcon.style.display = isPlaying ? 'block' : 'none';
      playIcon.style.display = isPlaying ? 'none' : 'block';
    }
    if (playPauseBtn) {
      playPauseBtn.setAttribute('aria-label', isPlaying ? 'Pause Auto-advance' : 'Resume Auto-advance');
    }
  };

  // Tab click listeners
  tabElements.forEach((tab) => {
    tab.addEventListener('click', () => {
      const idx = parseInt(tab.getAttribute('data-tab') || '0', 10);
      setScene(idx);
      if (isPlaying) {
        startTimer();
      }
    });
  });

  // Play / Pause toggle
  playPauseBtn?.addEventListener('click', () => {
    isPlaying = !isPlaying;
    updatePlayPauseUI();
    if (isPlaying) {
      startTimer();
    } else {
      stopTimer();
    }
  });

  // Pause when offscreen using IntersectionObserver
  if (stageWrapper && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) {
          stopTimer();
          stopSwitchCycle();
        } else if (isPlaying) {
          startTimer();
          if (currentScene === 2) startSwitchCycle();
        }
      });
    }, { threshold: 0.25 });
    observer.observe(stageWrapper);
  }

  // Initial Scene Set
  setScene(0);
  startTimer();
</script>
