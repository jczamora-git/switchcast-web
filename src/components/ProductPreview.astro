---
---

<section class="section preview-section" id="preview">
  <div class="container">
    
    <div class="section-header reveal">
      <span class="section-tag">Interactive Preview</span>
      <h2 class="section-title">Engineered for Seamless Presenter Flow</h2>
      <p class="section-subtitle">
        Inspect the genuine SwitchCast Fluent Design interface. Control live broadcasts, manage multi-source queues, and float companion controls over any application.
      </p>
    </div>

    <!-- UI Preview Wrapper -->
    <div class="preview-container glass-card reveal">
      
      <!-- Top Window Chrome / Tabs -->
      <div class="preview-chrome">
        <div class="window-controls">
          <span class="win-btn win-close"></span>
          <span class="win-btn win-min"></span>
          <span class="win-btn win-max"></span>
        </div>
        
        <div class="preview-tabs" role="tablist" aria-label="SwitchCast Interface Views">
          <button class="preview-tab active" data-tab="dashboard" role="tab" aria-selected="true">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7"></rect>
              <rect x="14" y="3" width="7" height="7"></rect>
              <rect x="14" y="14" width="7" height="7"></rect>
              <rect x="3" y="14" width="7" height="7"></rect>
            </svg>
            <span>Control Dashboard</span>
          </button>
          
          <button class="preview-tab" data-tab="dock" role="tab" aria-selected="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="15" width="20" height="6" rx="2"></rect>
              <line x1="6" y1="18" x2="6.01" y2="18"></line>
              <line x1="10" y1="18" x2="14" y2="18"></line>
            </svg>
            <span>Floating Presenter Dock</span>
          </button>

          <button class="preview-tab" data-tab="output" role="tab" aria-selected="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
            <span>Presentation Output (HWND)</span>
          </button>

          <button class="preview-tab" data-tab="sources" role="tab" aria-selected="false">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="12" y1="18" x2="12" y2="12"></line>
              <line x1="9" y1="15" x2="15" y2="15"></line>
            </svg>
            <span>Sources Manager</span>
          </button>
        </div>

        <div class="preview-badge">
          <span class="live-dot"></span>
          <span class="preview-badge-text">Direct3D 11 Active</span>
        </div>
      </div>

      <!-- VIEW PANELS -->
      <div class="preview-viewport">
        
        <!-- ========================================================= -->
        <!-- TAB 1: CONTROL DASHBOARD                                  -->
        <!-- ========================================================= -->
        <div class="preview-panel active" id="panel-dashboard">
          
          <!-- Dashboard App Shell -->
          <div class="mockup-shell">
            
            <!-- Dashboard Header Strip -->
            <div class="mock-header">
              <div class="mock-title-group">
                <span class="mock-title">Presentation Control</span>
                <span class="mock-subtitle">Live output preview, queue switching, and hardware video transport.</span>
              </div>
              <div class="mock-header-buttons">
                <span class="mock-btn-sm">Output Window</span>
                <span class="mock-btn-sm accent-border">Presenter Dock</span>
              </div>
            </div>

            <!-- Status Strip -->
            <div class="mock-status-strip">
              <div class="status-col">
                <span class="status-col-label">ACTIVE ON-AIR SOURCE</span>
                <div class="status-source-tag">
                  <span class="mock-glyph">🎬</span>
                  <span class="status-source-name">Product_Demo_1080p.mp4</span>
                  <span class="badge-source-type">Video Media</span>
                </div>
              </div>

              <div class="status-col">
                <span class="status-col-label">SWITCHING MODE</span>
                <span class="status-pill">Live Only (L)</span>
              </div>

              <div class="status-col">
                <span class="status-col-label">STREAM STATUS</span>
                <div class="status-live-pill">
                  <span class="live-dot"></span>
                  <span>ON AIR (1080p @ 60 FPS)</span>
                </div>
              </div>
            </div>

            <!-- Main 16:9 Canvas Preview -->
            <div class="mock-canvas-container">
              <div class="mock-canvas">
                <div class="canvas-video-visual">
                  <div class="mock-hero-visual-card">
                    <span class="canvas-source-watermark">SWITCHCAST PRESENTATION FEED</span>
                    <div class="canvas-app-preview-content">
                      <div class="canvas-code-line"><span class="code-hl-kwd">import</span> &#123; <span class="code-hl-var">PresentationEngine</span> &#125; <span class="code-hl-kwd">from</span> <span class="code-hl-str">'switchcast-core'</span>;</div>
                      <div class="canvas-code-line"><span class="code-hl-kwd">const</span> <span class="code-hl-var">stream</span> = <span class="code-hl-kwd">new</span> <span class="code-hl-var">PresentationEngine</span>(&#123; <span class="code-hl-var">outputHwnd</span>: <span class="code-hl-num">0x003F12A</span> &#125;);</div>
                      <div class="canvas-code-line"><span class="code-hl-var">stream</span>.<span class="code-hl-fn">switchSource</span>(<span class="code-hl-str">'video:product_demo'</span>, &#123; <span class="code-hl-var">seamless</span>: <span class="code-hl-bool">true</span> &#125;);</div>
                    </div>
                  </div>
                  <div class="canvas-onair-tag">● LIVE STREAM</div>
                </div>

                <!-- Live Video Controls Bar -->
                <div class="mock-video-controls-bar">
                  <div class="transport-btn-group">
                    <button class="mock-ctrl-btn" title="Restart Video">⏮</button>
                    <button class="mock-ctrl-btn" title="Seek -10s">⏪ 10s</button>
                    <button class="mock-ctrl-btn play-btn" title="Pause / Play">⏸</button>
                    <button class="mock-ctrl-btn" title="Seek +10s">⏩ 10s</button>
                  </div>

                  <!-- Timeline Slider -->
                  <div class="mock-timeline">
                    <div class="timeline-bar">
                      <div class="timeline-progress" style="width: 38%;"></div>
                      <div class="timeline-thumb" style="left: 38%;"></div>
                    </div>
                  </div>

                  <span class="mock-timecode">01:24 / 03:45</span>

                  <!-- Volume & Mute -->
                  <div class="mock-audio-group">
                    <button class="mock-ctrl-btn" title="Mute / Unmute">🔊</button>
                    <div class="volume-slider">
                      <div class="volume-progress" style="width: 85%;"></div>
                    </div>
                    <span class="volume-text">85%</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Presentation Queue Strip -->
            <div class="mock-queue-strip">
              <span class="queue-label">PRESENTATION QUEUE:</span>
              <div class="queue-items">
                <div class="queue-item">
                  <span class="q-num">1</span>
                  <span class="q-icon">💻</span>
                  <span class="q-name">VS Code — SwitchCast</span>
                </div>
                <div class="queue-item">
                  <span class="q-num">2</span>
                  <span class="q-icon">⬛</span>
                  <span class="q-name">Windows Terminal</span>
                </div>
                <div class="queue-item active">
                  <span class="q-num">3</span>
                  <span class="q-icon">🎬</span>
                  <span class="q-name">Product_Demo_1080p.mp4</span>
                  <span class="q-onair">LIVE</span>
                </div>
                <div class="queue-item">
                  <span class="q-num">4</span>
                  <span class="q-icon">🖥️</span>
                  <span class="q-name">Display 2 (4K Physical)</span>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 2: FLOATING PRESENTER DOCK                            -->
        <!-- ========================================================= -->
        <div class="preview-panel" id="panel-dock">
          <div class="mockup-dock-environment">
            <div class="desktop-bg-app">
              <div class="fake-ide-header">
                <span class="ide-tab active">PresenterWorkflow.cs</span>
                <span class="ide-tab">PresentationCoordinator.cs</span>
              </div>
              <div class="fake-ide-code">
                <p><span class="code-hl-com">// Your IDE or presentation software stays in focus</span></p>
                <p><span class="code-hl-kwd">public async</span> Task <span class="code-hl-fn">HandleSourceSwitchAsync</span>(SourceItem source) &#123;</p>
                <p>&nbsp;&nbsp;&nbsp;&nbsp;<span class="code-hl-kwd">await</span> _coordinator.<span class="code-hl-fn">TransitionToAsync</span>(source);</p>
                <p>&nbsp;&nbsp;&nbsp;&nbsp;_dockViewModel.<span class="code-hl-fn">UpdateActiveTimeline</span>(source);</p>
                <p>&#125;</p>
              </div>
            </div>

            <!-- The Floating Dock Overlay -->
            <div class="floating-dock-card">
              <div class="dock-row-main">
                <!-- Caption Drag Grip -->
                <div class="dock-grip" title="Drag Presenter Dock">
                  <span>⋮⋮</span>
                </div>

                <!-- On-Air Status -->
                <div class="dock-status-group">
                  <span class="live-dot"></span>
                  <span class="dock-onair-text">ON AIR</span>
                </div>

                <div class="dock-divider"></div>

                <!-- Active Source Button -->
                <div class="dock-source-picker">
                  <span class="dock-icon">🎬</span>
                  <span class="dock-source-title">3: Product_Demo_1080p.mp4</span>
                  <span class="dock-chevron">▼</span>
                </div>

                <div class="dock-divider"></div>

                <!-- Mode Indicator -->
                <span class="dock-mode-pill" title="Live Only Mode">L</span>

                <div class="dock-divider"></div>

                <!-- Quick Action Buttons -->
                <div class="dock-btn-group">
                  <button class="dock-btn" title="Mute Video (🔊)">🔊</button>
                  <button class="dock-btn" title="Pause / Freeze Frame (Ctrl+Shift+P)">⏸</button>
                  <button class="dock-btn" title="Blackout Privacy (Ctrl+Shift+B)">🕶️</button>
                  <button class="dock-btn" title="Toggle Fullscreen Output">⛶</button>
                  <button class="dock-btn stop-btn" title="Stop Presentation (Ctrl+Shift+S)">⏹</button>
                </div>
              </div>

              <!-- Adaptive Video Scrubber Row on Dock -->
              <div class="dock-row-video">
                <div class="dock-transport">
                  <button class="dock-t-btn">⏮</button>
                  <button class="dock-t-btn">⏪</button>
                  <button class="dock-t-btn accent">⏸</button>
                  <button class="dock-t-btn">⏩</button>
                </div>
                <div class="dock-timeline-slider">
                  <div class="dock-timeline-fill" style="width: 45%;"></div>
                </div>
                <span class="dock-timecode">01:24 / 03:45</span>
              </div>
            </div>
            
            <div class="dock-annotation">
              <span class="annotation-text">✨ Native Windows Non-Client Caption Dragging • Single-Row Baseline Toolbar</span>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 3: PRESENTATION OUTPUT (HWND)                         -->
        <!-- ========================================================= -->
        <div class="preview-panel" id="panel-output">
          <div class="mockup-output-window">
            <div class="output-window-header">
              <div class="output-header-left">
                <img src="/assets/switchcast-logo.svg" width="16" height="16" alt="Icon" />
                <span class="output-title">SwitchCast Presentation Output — 1920x1080 (Single Stable HWND)</span>
              </div>
              <div class="output-header-right">
                <span class="output-badge">Shared in Conferencing Software</span>
              </div>
            </div>

            <div class="output-window-body">
              <div class="output-video-canvas">
                <div class="output-stream-content">
                  <div class="output-visual-mock">
                    <span class="output-live-pill">● AUDIENCE VIEW</span>
                    <h3>High-Performance Low-Latency Stream</h3>
                    <p>Direct3D 11 SwapChain Canvas • Pure 16:9 Letterboxed Feed</p>
                  </div>
                </div>
              </div>
            </div>

            <div class="output-explanation">
              <div class="exp-card">
                <span class="exp-icon">🛡️</span>
                <span class="exp-title">Zero Share Renegotiation</span>
                <p>Zoom, Google Meet, and Teams never disconnect or flash black because the output HWND remains constant throughout your entire presentation.</p>
              </div>
              <div class="exp-card">
                <span class="exp-icon">⛶</span>
                <span class="exp-title">Borderless Fullscreen</span>
                <p>Toggle native 100% viewport fullscreen (Escape to exit) instantly without affecting your screen-share window handle.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- ========================================================= -->
        <!-- TAB 4: SOURCES MANAGER                                    -->
        <!-- ========================================================= -->
        <div class="preview-panel" id="panel-sources">
          <div class="mockup-sources-manager">
            <div class="sources-header-bar">
              <div class="sources-title-block">
                <h3>Sources Manager</h3>
                <p>Select application windows, physical displays, and local media files to queue.</p>
              </div>
              <div class="sources-actions">
                <button class="mock-btn-sm">Add Image File</button>
                <button class="mock-btn-sm accent-border">Add Video File</button>
                <button class="mock-btn-sm">Refresh List</button>
              </div>
            </div>

            <div class="sources-grid">
              <div class="source-group">
                <span class="source-group-title">OPEN WINDOWS (4 AVAILABLE)</span>
                <div class="source-row checked">
                  <input type="checkbox" checked disabled />
                  <span class="app-icon-badge">VS</span>
                  <div class="source-row-info">
                    <span class="source-main-title">SwitchCast.sln — Visual Studio 2022</span>
                    <span class="source-sub-title">devenv.exe • HWND: 0x0041B2</span>
                  </div>
                  <span class="source-pos-tag">Queue #1</span>
                </div>

                <div class="source-row checked">
                  <input type="checkbox" checked disabled />
                  <span class="app-icon-badge">WT</span>
                  <div class="source-row-info">
                    <span class="source-main-title">PowerShell — Administrator</span>
                    <span class="source-sub-title">WindowsTerminal.exe • HWND: 0x002FA1</span>
                  </div>
                  <span class="source-pos-tag">Queue #2</span>
                </div>

                <div class="source-row">
                  <input type="checkbox" disabled />
                  <span class="app-icon-badge">GC</span>
                  <div class="source-row-info">
                    <span class="source-main-title">Google Chrome — GitHub Releases</span>
                    <span class="source-sub-title">chrome.exe</span>
                  </div>
                </div>
              </div>

              <div class="source-group">
                <span class="source-group-title">LOCAL MEDIA FILES & DISPLAYS</span>
                <div class="source-row checked">
                  <input type="checkbox" checked disabled />
                  <span class="app-icon-badge media-badge">🎬</span>
                  <div class="source-row-info">
                    <span class="source-main-title">Product_Demo_1080p.mp4</span>
                    <span class="source-sub-title">MP4 Video • 1080p • 03:45</span>
                  </div>
                  <span class="source-pos-tag live-tag">Queue #3 (ON-AIR)</span>
                </div>

                <div class="source-row checked">
                  <input type="checkbox" checked disabled />
                  <span class="app-icon-badge display-badge">🖥️</span>
                  <div class="source-row-info">
                    <span class="source-main-title">Display 2 (Primary Presentation Display)</span>
                    <span class="source-sub-title">3840 x 2160 (Physical Monitor)</span>
                  </div>
                  <span class="source-pos-tag">Queue #4</span>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .preview-section {
    padding-top: 2rem;
  }

  .preview-container {
    overflow: hidden;
    border: 1px solid var(--sc-border-base);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7);
  }

  .preview-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0f1015;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--sc-border-base);
    flex-wrap: wrap;
    gap: 1rem;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .win-btn {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .win-close { background: #ff5f56; }
  .win-min { background: #ffbd2e; }
  .win-max { background: #27c93f; }

  .preview-tabs {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #181920;
    padding: 0.25rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--sc-border-subtle);
  }

  .preview-tab {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    border: none;
    color: var(--sc-text-secondary);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-xs);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .preview-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.05);
  }

  .preview-tab.active {
    color: #ffffff;
    background: var(--sc-bg-surface-elevated);
    border: 1px solid var(--sc-border-base);
    box-shadow: var(--shadow-sm);
  }

  .preview-tab.active svg {
    color: var(--sc-accent);
  }

  .preview-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--sc-text-secondary);
  }

  .preview-viewport {
    background: #0b0c10;
    min-height: 520px;
    padding: 1.5rem;
    position: relative;
  }

  .preview-panel {
    display: none;
  }

  .preview-panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mockup Inner Styles */
  .mockup-shell {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .mock-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .mock-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #ffffff;
    display: block;
  }

  .mock-subtitle {
    font-size: 0.82rem;
    color: var(--sc-text-secondary);
  }

  .mock-header-buttons {
    display: flex;
    gap: 0.5rem;
  }

  .mock-btn-sm {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.35rem 0.75rem;
    background: var(--sc-bg-surface);
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-xs);
    color: var(--sc-text-primary);
  }

  .mock-btn-sm.accent-border {
    border-color: var(--sc-accent);
    color: var(--sc-accent);
  }

  .mock-status-strip {
    display: grid;
    grid-template-columns: 2fr 1fr 1.2fr;
    gap: 1rem;
    background: #14151c;
    border: 1px solid var(--sc-border-base);
    padding: 0.85rem 1.25rem;
    border-radius: var(--radius-md);
  }

  .status-col {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .status-col-label {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    color: var(--sc-text-tertiary);
    letter-spacing: 0.05em;
  }

  .status-source-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .badge-source-type {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    padding: 0.1rem 0.4rem;
    background: rgba(255, 122, 89, 0.15);
    color: var(--sc-accent);
    border-radius: 3px;
  }

  .status-pill {
    font-size: 0.82rem;
    font-weight: 600;
    color: #ffffff;
    background: #20222e;
    padding: 0.2rem 0.6rem;
    border-radius: 4px;
    width: fit-content;
  }

  .status-live-pill {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--sc-live);
  }

  .mock-canvas-container {
    background: #07080a;
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .mock-canvas {
    display: flex;
    flex-direction: column;
    min-height: 280px;
  }

  .canvas-video-visual {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at center, #1c1d28 0%, #0d0e14 100%);
    padding: 2.5rem 1.5rem;
  }

  .mock-hero-visual-card {
    background: rgba(14, 15, 20, 0.9);
    border: 1px solid var(--sc-border-base);
    padding: 1.5rem 2rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    max-width: 580px;
    width: 100%;
  }

  .canvas-source-watermark {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--sc-accent);
    display: block;
    margin-bottom: 0.75rem;
    letter-spacing: 0.1em;
  }

  .canvas-app-preview-content {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    line-height: 1.6;
    color: #d1d5db;
  }

  .code-hl-kwd { color: #ff7a59; font-weight: 600; }
  .code-hl-var { color: #93c5fd; }
  .code-hl-str { color: #86efac; }
  .code-hl-fn { color: #fde047; }
  .code-hl-num { color: #f472b6; }
  .code-hl-bool { color: #f97316; }
  .code-hl-com { color: #6b7280; font-style: italic; }

  .canvas-onair-tag {
    position: absolute;
    top: 1rem;
    right: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    color: #ffffff;
    background: var(--sc-live);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    box-shadow: 0 2px 10px var(--sc-live-glow);
  }

  .mock-video-controls-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: #12131b;
    border-top: 1px solid var(--sc-border-base);
    padding: 0.65rem 1.25rem;
    flex-wrap: wrap;
  }

  .transport-btn-group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .mock-ctrl-btn {
