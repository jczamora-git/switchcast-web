---
import releaseData from '../data/release.json';
---

<header class="navbar-wrapper" id="navbar">
  <div class="navbar-glass-container">
    
    <!-- Brand Logo -->
    <a href="/" class="brand-link" aria-label="SwitchCast Home">
      <div class="brand-icon-wrapper">
        <img src="/assets/switchcast-logo.svg" alt="" width="22" height="22" />
      </div>
      <div class="brand-text-group">
        <span class="brand-name">SwitchCast</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Primary Navigation">
      <a href="/#showcase" class="nav-link">How It Works</a>
      <a href="/#demo" class="nav-link">Try Demo</a>
      <a href="/#why-switchcast" class="nav-link">Why SwitchCast</a>
      <a href="/releases/" class="nav-link">Releases</a>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <a href={releaseData.sourceRepoUrl} target="_blank" rel="noopener noreferrer" class="github-btn" title="View Source on GitHub" aria-label="GitHub Repository">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
      
      <a href="/#download" class="btn btn-primary btn-sm nav-download-btn">
        <span>Download</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle Navigation Menu" aria-expanded="false" aria-controls="mobileMenu">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
      </button>
    </div>

  </div>

  <!-- Mobile Backdrop Overlay -->
  <div class="mobile-backdrop" id="mobileBackdrop" aria-hidden="true"></div>

  <!-- Mobile Dropdown Menu Floating Glass Card -->
  <div class="mobile-menu-card" id="mobileMenu" role="region" aria-label="Mobile Navigation">
    <nav class="mobile-nav-links">
      <a href="/#showcase" class="mobile-nav-link">
        <span class="nav-num">01</span>
        <span>How It Works</span>
      </a>
      <a href="/#demo" class="mobile-nav-link">
        <span class="nav-num">02</span>
        <span>Try Demo</span>
      </a>
      <a href="/#why-switchcast" class="mobile-nav-link">
        <span class="nav-num">03</span>
        <span>Why SwitchCast</span>
      </a>
      <a href="/releases/" class="mobile-nav-link">
        <span class="nav-num">04</span>
        <span>Releases</span>
      </a>
      <a href={releaseData.sourceRepoUrl} target="_blank" rel="noopener noreferrer" class="mobile-nav-link github-mobile-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub Repository</span>
      </a>
      <div class="mobile-menu-actions">
        <a href="/#download" class="btn btn-primary btn-md w-full">
          <span>Download for Windows</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0.85rem;
    left: 0;
    right: 0;
    z-index: 120;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 1rem;
    pointer-events: none;
  }

  /* Refined Floating Glass Container */
  .navbar-glass-container {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 52px;
    padding: 0 1rem;
    background: linear-gradient(180deg, rgba(24, 25, 34, 0.78) 0%, rgba(14, 15, 21, 0.84) 100%);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-full);
    box-shadow: 
      inset 0 1px 0 0 rgba(255, 255, 255, 0.14),
      0 16px 38px rgba(0, 0, 0, 0.55),
      0 2px 6px rgba(0, 0, 0, 0.35);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;
  }

  .navbar-glass-container:hover {
    border-color: rgba(255, 255, 255, 0.15);
    box-shadow: 
      inset 0 1px 0 0 rgba(255, 255, 255, 0.2),
      0 18px 44px rgba(0, 0, 0, 0.65),
      0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    flex-shrink: 0;
    padding: 0.25rem 0.25rem 0.25rem 0;
  }

  .brand-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.86rem;
    font-weight: 500;
    color: var(--sc-text-secondary);
    position: relative;
    padding: 0.25rem 0;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--sc-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-shrink: 0;
  }

  .github-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--sc-text-secondary);
    width: 30px;
    height: 30px;
    border-radius: 50%;
    transition: color 0.2s ease, background 0.2s ease;
  }

  .github-btn:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
  }

  .nav-download-btn {
    padding: 0.38rem 1rem;
    font-size: 0.82rem;
    font-weight: 600;
    border-radius: var(--radius-full);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 36px;
    height: 36px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    border-radius: var(--radius-sm);
    color: var(--sc-text-primary);
  }

  .mobile-toggle:focus-visible {
    outline: 2px solid var(--sc-accent);
    outline-offset: 2px;
  }

  .mobile-toggle .bar {
    width: 17px;
    height: 2px;
    background-color: var(--sc-text-primary);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  .mobile-toggle[aria-expanded="true"] .bar-1 {
    transform: translateY(3.5px) rotate(45deg);
  }

  .mobile-toggle[aria-expanded="true"] .bar-2 {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* Mobile Backdrop */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 110;
    pointer-events: auto;
  }

  .mobile-backdrop.is-open {
    display: block;
  }

  /* Mobile Glass Dropdown Card */
  .mobile-menu-card {
    pointer-events: auto;
    display: none;
    position: relative;
    z-index: 125;
    margin-top: 0.65rem;
    background: linear-gradient(180deg, rgba(22, 23, 31, 0.94) 0%, rgba(14, 15, 21, 0.96) 100%);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(255, 255, 255, 0.11);
    border-radius: var(--radius-lg);
    padding: 1.15rem 1.25rem;
    box-shadow: 
      inset 0 1px 0 0 rgba(255, 255, 255, 0.15),
      0 20px 48px rgba(0, 0, 0, 0.7);
    animation: menu-slide-down 0.22s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-menu-card.is-open {
    display: block;
  }

  @keyframes menu-slide-down {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .mobile-nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--sc-text-primary);
    padding: 0.35rem 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    transition: color 0.2s ease;
  }

  .nav-num {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--sc-accent);
    opacity: 0.85;
  }

  .mobile-nav-link:hover {
    color: var(--sc-accent);
  }

  .github-mobile-link {
    color: var(--sc-text-secondary);
    font-size: 0.86rem;
  }

  .mobile-menu-actions {
    margin-top: 0.5rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--sc-border-subtle);
  }

  .w-full {
    width: 100%;
  }

  /* Responsive Rules */
  @media (max-width: 820px) {
    .nav-links, .github-btn {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .navbar-glass-container {
      padding: 0 0.85rem 0 1rem;
      height: 48px;
    }
  }

  @media (max-width: 480px) {
    .navbar-wrapper {
      padding: 0 0.65rem;
      top: 0.65rem;
    }

    .nav-download-btn {
      display: none;
    }

    .brand-name {
      font-size: 0.96rem;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileBackdrop = document.getElementById('mobileBackdrop');

  if (toggleBtn && mobileMenu) {
    const toggleMenu = (open?: boolean) => {
      const shouldOpen = open !== undefined ? open : !mobileMenu.classList.contains('is-open');
      mobileMenu.classList.toggle('is-open', shouldOpen);
      if (mobileBackdrop) {
        mobileBackdrop.classList.toggle('is-open', shouldOpen);
      }
      toggleBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
    };

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMenu();
    });

    // Close on backdrop click
    mobileBackdrop?.addEventListener('click', () => {
      toggleMenu(false);
    });

    // Close on any link click
    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        toggleMenu(false);
      });
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileMenu.classList.contains('is-open')) {
        toggleMenu(false);
        toggleBtn.focus();
      }
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      if (mobileMenu.classList.contains('is-open') && target && !mobileMenu.contains(target) && !toggleBtn.contains(target)) {
        toggleMenu(false);
      }
    });
  }
</script>
