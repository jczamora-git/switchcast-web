---
import releaseData from '../data/release.json';
---

<header class="navbar-header" id="navbar">
  <div class="container navbar-container">
    <!-- Brand Logo -->
    <a href="#" class="brand-link" aria-label="SwitchCast Home">
      <div class="brand-icon-wrapper">
        <img src="/assets/switchcast-logo.svg" alt="SwitchCast Icon" width="28" height="28" />
      </div>
      <div class="brand-text-group">
        <span class="brand-name">SwitchCast</span>
        <span class="brand-version">v{releaseData.version}</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="nav-links" aria-label="Main Navigation">
      <a href="#features" class="nav-link">Features</a>
      <a href="#preview" class="nav-link">Preview</a>
      <a href="#how-it-works" class="nav-link">Workflow</a>
      <a href="#use-cases" class="nav-link">Use Cases</a>
      <a href="#requirements" class="nav-link">Requirements</a>
      <a href="#faq" class="nav-link">FAQ</a>
    </nav>

    <!-- Header Actions -->
    <div class="nav-actions">
      <a href={releaseData.sourceRepoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm github-btn" title="View Source on GitHub">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>GitHub</span>
      </a>
      <a href="#download" class="btn btn-primary btn-sm nav-download-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>Download</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobileMenuToggle" aria-label="Toggle Navigation Menu" aria-expanded="false">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div class="mobile-menu" id="mobileMenu">
    <nav class="mobile-nav-links">
      <a href="#features" class="mobile-nav-link">Features</a>
      <a href="#preview" class="mobile-nav-link">Preview</a>
      <a href="#how-it-works" class="mobile-nav-link">Workflow</a>
      <a href="#use-cases" class="mobile-nav-link">Use Cases</a>
      <a href="#requirements" class="mobile-nav-link">Requirements</a>
      <a href="#faq" class="mobile-nav-link">FAQ</a>
      <div class="mobile-menu-actions">
        <a href="#download" class="btn btn-primary btn-lg w-full">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download for Windows</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(13, 14, 18, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--sc-border-subtle);
    transition: background 0.3s ease, border-color 0.3s ease;
  }

  .navbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 72px;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    background: var(--sc-bg-surface);
    border: 1px solid var(--sc-border-base);
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .brand-text-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .brand-version {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--sc-accent);
    background: var(--sc-accent-soft);
    border: 1px solid rgba(255, 122, 89, 0.25);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-xs);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .nav-link {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--sc-text-secondary);
    position: relative;
    padding: 0.25rem 0;
  }

  .nav-link:hover {
    color: #ffffff;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--sc-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 32px;
    height: 22px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 110;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--sc-text-primary);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .mobile-menu {
    display: none;
    position: absolute;
    top: 72px;
    left: 0;
    right: 0;
    background: var(--sc-bg-secondary);
    border-bottom: 1px solid var(--sc-border-base);
    padding: 1.5rem;
    box-shadow: var(--shadow-lg);
  }

  .mobile-menu.is-open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--sc-text-primary);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--sc-border-subtle);
  }

  .mobile-menu-actions {
    margin-top: 1rem;
  }

  .w-full {
    width: 100%;
  }

  @media (max-width: 860px) {
    .nav-links, .github-btn {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');

  if (toggleBtn && mobileMenu) {
    toggleBtn.addEventListener('click', () => {
      const isOpen = mobileMenu.classList.toggle('is-open');
      toggleBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });

    const mobileLinks = mobileMenu.querySelectorAll('a');
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.remove('is-open');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
